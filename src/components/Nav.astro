---
interface Props {
  page?: 'home' | 'work';
}

const { page = 'home' } = Astro.props;
// section anchors live on the home page; other pages link back to them
const home = page === 'home' ? '' : '/';
---

<header class="nav" id="nav">
  <div class="nav-inner container">
    <a href={page === 'home' ? '#top' : '/'} class="nav-logo" aria-label="DevStudioCraft home">
      <span class="nav-logo-mark" aria-hidden="true"></span>
      DEVSTUDIOCRAFT<span class="nav-logo-dot">.</span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="/work/" class="nav-link-work" aria-current={page === 'work' ? 'page' : undefined}>Work</a>
      <a href={`${home}#trades`}>Your trade</a>
      <a href={`${home}#services`}>Services</a>
      <a href={`${home}#process`}>Process</a>
      <a href={`${home}#edge`}>Why us</a>
      <a href={`${home}#packages`}>Packages</a>
    </nav>
    <a href="#contact" class="btn btn-acid nav-cta" data-magnetic aria-label="Start a project">
      <span class="btn-fill"></span>
      <span>Start<span class="nav-cta-more"> a project</span></span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding-block: 1.1rem;
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      padding 0.4s ease;
  }

  .nav.is-scrolled {
    padding-block: 0.7rem;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .nav-logo-dot {
    color: var(--acid);
  }

  .nav-logo-mark {
    width: 10px;
    height: 10px;
    background: var(--acid);
    border-radius: 2px;
    rotate: 45deg;
  }

  .nav-links {
    display: flex;
    gap: 2.2rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgb(242 239 232 / 0.72);
  }

  .nav-links a {
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.3s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--acid);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-expo);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-cta {
    padding: 0.75rem 1.5rem;
    font-size: 0.85rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .nav-links {
      margin-left: auto;
    }

    .nav-inner {
      gap: 0.75rem;
    }

    .nav-logo {
      font-size: 0.9rem;
      letter-spacing: 0.02em;
    }

    .nav-cta {
      padding: 0.7rem 1.2rem;
      font-size: 0.8rem;
    }

    /* phones keep one link: the portfolio */
    .nav-links a:not(.nav-link-work) {
      display: none;
    }
  }

  /* small phones: the longer wordmark leaves room for a one-word button */
  @media (max-width: 400px) {
    .nav-cta-more {
      display: none;
    }

    .nav-logo {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 340px) {
    .nav-inner {
      gap: 0.55rem;
    }

    .nav-cta {
      padding: 0.65rem 0.9rem;
    }
  }
</style>
