---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-col footer-brand">
        <span class="footer-tag">Digital studio</span>
        <p>
          Websites, e-commerce, landing pages and apps —
          designed and engineered to sell.
        </p>
      </div>
      <nav class="footer-col" aria-label="Sitemap">
        <span class="footer-tag">Explore</span>
        <a href="#services">Services</a>
        <a href="#work">Capabilities</a>
        <a href="#process">Process</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="footer-col">
        <span class="footer-tag">Connect</span>
        <a href="https://instagram.com" rel="noopener">Instagram</a>
        <a href="https://behance.net" rel="noopener">Behance</a>
        <a href="https://linkedin.com" rel="noopener">LinkedIn</a>
        <a href="mailto:hello@devstudiocraft.com">hello@devstudiocraft.com</a>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true" data-wordmark>
      <span>DEVCRAFT</span><span class="footer-dot">.</span>
    </div>

    <div class="footer-bottom">
      <span>© {year} DevCraft Studio. All rights reserved.</span>
      <span>Made in Cairo — shipping worldwide.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    padding-top: var(--space-section);
    overflow: clip;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .footer-col {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    justify-items: start;
  }

  .footer-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }

  .footer-brand p {
    color: var(--ink-dim);
    max-width: 22rem;
    text-wrap: pretty;
  }

  .footer-col a {
    color: var(--ink-dim);
    transition: color 0.3s ease;
    width: fit-content;
  }

  .footer-col a:hover {
    color: var(--acid);
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(3.5rem, 15vw, 14.5rem);
    line-height: 0.78;
    text-align: center;
    color: var(--ink);
    white-space: nowrap;
    user-select: none;
  }

  .footer-dot {
    color: var(--acid);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
