---
interface Props {
  // prefix for in-page anchors; '/' when rendered outside the home page
  base?: string;
}

const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-col footer-brand">
        <span class="footer-tag">Digital studio</span>
        <p>
          Websites, e-commerce, landing pages and apps —
          designed and engineered to sell.
        </p>
        <address class="footer-address">
          Bürgermeister-Smidt-Straße 116<br />
          28195 Bremen, Germany
        </address>
      </div>
      <nav class="footer-col" aria-label="Sitemap">
        <span class="footer-tag">Explore</span>
        <a href={`${base}#services`}>Services</a>
        <a href={`${base}#work`}>Capabilities</a>
        <a href={`${base}#process`}>Process</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
      <div class="footer-col">
        <span class="footer-tag">Connect</span>
        <a href="mailto:contact@devstudiocraft.com">contact@devstudiocraft.com</a>
        <a href="tel:+4915222002210">+49 1522 2002210</a>
      </div>
      <nav class="footer-col" aria-label="Legal">
        <span class="footer-tag">Legal</span>
        <a href="/impressum/">Impressum</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms</a>
      </nav>
    </div>

    <div class="footer-wordmark" aria-hidden="true" data-wordmark>
      <span>DEVSTUDIOCRAFT</span><span class="footer-dot">.</span>
    </div>

    <div class="footer-bottom">
      <span>
        © {year} DevStudioCraft — a brand of
        <a href="https://m2a-group.de/" rel="noopener">M2A Group</a>, operated by
        <a href="https://m2a-fm.de/" rel="noopener">M2A Facility Management GmbH</a>.
      </span>
      <span>Made in Bremen — shipping worldwide.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    padding-top: var(--space-section);
    overflow: clip;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .footer-col {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    justify-items: start;
  }

  .footer-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }

  .footer-brand p {
    color: var(--ink-dim);
    max-width: 22rem;
    text-wrap: pretty;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .footer-col a {
    color: var(--ink-dim);
    transition: color 0.3s ease;
    width: fit-content;
  }

  .footer-col a:hover,
  .footer-bottom a:hover {
    color: var(--acid);
  }

  .footer-bottom a {
    color: var(--ink-dim);
    transition: color 0.3s ease;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 8.6vw, 8.4rem);
    line-height: 0.78;
    text-align: center;
    color: var(--ink);
    white-space: nowrap;
    user-select: none;
  }

  .footer-dot {
    color: var(--acid);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
