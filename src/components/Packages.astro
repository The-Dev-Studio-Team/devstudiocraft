    label: 'Marketing',
    count: '04',
    cards: [
      {
        num: '01',
        badge: 'Getting started',
        title: 'Spark',
        forLine: 'For brands ready to look serious online.',
        desc: 'We take content off your plate — created, designed and published, with your community handled across three platforms. You run the business. We run the feed.',
        items: [
          'Content creation & publishing',
          'Graphic design',
          'Community management — 3 platforms',
        ],
      },
      {
        num: '02',
        badge: 'The machine',
        title: 'Engine',
        forLine: 'For brands that want the whole machine.',
        desc: 'Your full marketing department, outsourced: strategy, content calendar, paid media and video — every platform managed, every metric reported, reviewed with you each cycle.',
        items: [
          'Everything in Spark',
          'Growth strategy & KPI reporting',
