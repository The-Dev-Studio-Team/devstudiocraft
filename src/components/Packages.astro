    label: 'Branding',
    count: '03',
    cards: [
      {
        num: '01',
        badge: 'The essentials',
        title: 'Mark',
        forLine: 'For new businesses that need to look real, fast.',
        desc: "One logo done properly — primary and secondary marks plus a social-ready variant, shaped through real revision rounds and delivered in every format you'll ever be asked for.",
        items: [
