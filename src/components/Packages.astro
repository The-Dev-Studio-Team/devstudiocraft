const singles = [
  { title: 'Market analysis', desc: 'Deep-dive competitor research and market positioning report.', time: '25 days' },
  { title: 'Marketing strategy', desc: 'Actionable brand strategy with channel plan, messaging and KPIs.', time: '25 days' },
  { title: 'Content plan + designs', desc: 'Monthly content calendar with every graphic designed, ready to post.', time: '25 days' },
  { title: 'Media buying', desc: 'Paid ad management — budgets, creative testing, honest reporting.', time: '30 days' },
  { title: 'Social moderation', desc: 'Daily community management — replies, DMs and engagement.', time: '30 days' },
  { title: 'Photoshoot', desc: 'Professional brand photography — product, portrait or lifestyle.', time: 'By arrangement' },
  { title: 'Video editing', desc: 'Cuts, colour grade, captions, music — up to 8 minutes.', time: '5 days' },
  { title: 'Reel pack', desc: 'Three 60-second short-form reels — filmed, edited, optimised.', time: 'By arrangement' },
  { title: 'SEO audit', desc: 'Full technical + content audit with a prioritised fix list.', time: '5 days' },
  { title: 'Speed rescue', desc: "Find and fix what's slowing your site — measured before and after.", time: '3 days' },
  { title: 'Bug fixing', desc: 'Rapid diagnosis and repair of bugs, broken links and errors.', time: '1 day' },
  { title: 'Website care', desc: 'Monthly upkeep — updates, security checks, performance watch.', time: 'Monthly' },
];

const industries = [
  'E-commerce',
  'Restaurants & food',
  'Fashion & beauty',
  'Real estate',
  'Health & clinics',
  'Education',
  'SaaS & startups',
  'Other',
];

const trust = [
  'First concept in 48h',
  'You own everything',
  'No lock-in contracts',
  'Replies within 24h',
