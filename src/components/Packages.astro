---
/*
  Packages: who each plan is for, what you get, when, and what it buys you.
  `title` + `category` are the keys the inquiry function and its email templates use
  (functions/api/_email-templates.js PLANS): keep them in sync if a plan is renamed.
*/
const tabs = [
  {
    id: 'technology',
    label: 'Websites & apps',
    category: 'Technology',
    count: '03',
    blurb: 'A site that loads fast, shows up on Google and turns visitors into calls, bookings and orders.',
    cards: [
      {
        title: 'Launch',
        what: 'One landing page, live in two weeks',
        forWho: 'A launch, an offer or a campaign that can’t wait.',
        gets: ['Design and copy structure', 'Hand-coded page', 'Analytics set up from day one'],
        timing: '2-week sprint',
        result: 'A page with one job, turning visitors into sign-ups or sales, and numbers that show how it’s doing.',
      },
      {
        title: 'Foundation',
        what: 'Your business website',
        forWho: 'A salon, clinic, gym or restaurant that needs a site customers trust.',
        gets: ['Design for phone and desktop', 'Custom build, security-hardened', 'Set up to be found on Google', '95+ Google speed score target'],
        timing: '3 months of support after launch',
        result: 'A fast site that shows up in search and makes it easy to call, book or walk in.',
      },
      {
        title: 'Powerhouse',
        badge: 'Most brands pick this',
        featured: true,
        what: 'Your website, plus custom features',
        forWho: 'A business that runs on its site: a shop, bookings, logins or connected tools.',
        gets: ['Everything in Foundation', 'Custom features, front to back', 'Connects to the tools you already use', 'Built to stay fast under real traffic'],
        timing: '6 months of support after launch',
        result: 'One system that handles real customers, real orders and real traffic.',
      },
    ],
  },
  {
    id: 'branding',
    label: 'Branding',
    category: 'Branding',
    count: '03',
    blurb: 'Look like the business you are, on the sign, the cup, the card and the screen.',
    cards: [
      {
        title: 'Mark',
        what: 'Your logo, done properly',
        forWho: 'A new business that needs to look real, fast.',
        gets: ['1 logo, with real revision rounds', 'Primary and secondary versions', 'Social media kit', 'Every format: SVG, PNG, PDF, JPEG'],
        result: 'A logo that looks right on a shopfront, a cup and a phone screen.',
      },
      {
        title: 'System',
        badge: 'Most brands pick this',
        featured: true,
        what: 'Logo plus business stationery',
        forWho: 'A business that wants one consistent look everywhere.',
        gets: ['2 logo directions, refined to one', 'Business card and letterhead', 'Social media kit', 'Full source files'],
        result: 'Every card, post and letter looks like it comes from the same business.',
      },
      {
        title: 'Legacy',
        what: 'A complete brand system',
        forWho: 'An organisation building to last, with a team that needs clear rules.',
        gets: ['2 logo directions', 'Full brand guidelines', 'Email signature and letterhead', 'Every printable asset', 'Full ownership documents'],
        result: 'A brand your whole team can use correctly, without calling us.',
      },
    ],
  },
  {
    id: 'marketing',
    label: 'Marketing',
    category: 'Marketing',
    count: '04',
    blurb: 'Keep new customers finding you and old ones coming back, without doing it yourself.',
    cards: [
      {
        title: 'Spark',
        what: 'Social media, done for you',
        forWho: 'A business that wants an active, good-looking feed without the work.',
        gets: ['Posts created and published', 'Graphic design', 'Comments and messages answered on 3 platforms'],
        timing: 'Ongoing',
        result: 'Your feed stays active and professional while you run the business.',
      },
      {
        title: 'Engine',
        what: 'Your marketing department, outsourced',
        forWho: 'A business ready to grow with a plan and paid ads.',
        gets: ['Everything in Spark', 'Growth plan and KPI reports', 'Paid ads managed', 'Video editing', 'Every platform moderated'],
        timing: 'Reviewed with you every cycle',
        result: 'A plan, measured ads and a report that shows what actually worked.',
      },
      {
        title: 'Overdrive',
        badge: 'Most brands pick this',
        featured: true,
        what: 'Marketing with your own photo and video team',
        forWho: 'A brand ready to own attention in its city or niche.',
        gets: ['Everything in Engine', 'Brand photography', 'Full video production', 'A dedicated creative team'],
        timing: 'Billed annually, 20% off',
        result: 'Content that looks like you, because it was shot for you.',
      },
      {
        title: 'Command',
        what: 'Marketing, website and reputation, handled',
        forWho: 'A business where marketing simply can’t fail.',
        gets: ['Everything in Overdrive', 'Website management', 'Reputation and risk cover', 'A dedicated account manager'],
        timing: 'Ongoing',
        result: 'One team owns your marketing, your website and your reputation.',
      },
    ],
  },
];

const singles = [
  { title: 'Market analysis', desc: 'Who your competitors are, what they do well, and where you can win.', time: '25 days' },
  { title: 'Marketing strategy', desc: 'A clear plan: which channels, what to say, how to measure it.', time: '25 days' },
  { title: 'Content plan + designs', desc: 'A month of posts planned and designed, ready to publish.', time: '25 days' },
  { title: 'Media buying', desc: 'Your ads run for you: budgets, creative tests, honest reports.', time: '30 days' },
  { title: 'Social moderation', desc: 'Comments, DMs and replies handled every day.', time: '30 days' },
  { title: 'Photoshoot', desc: 'Professional photos of your products, your team or your space.', time: 'By arrangement' },
  { title: 'Video editing', desc: 'Cut, colour, captions and music, up to 8 minutes.', time: '5 days' },
  { title: 'Reel pack', desc: 'Three 60-second reels, filmed and edited for social.', time: 'By arrangement' },
  { title: 'SEO audit', desc: 'A full check of your site with a ranked list of fixes.', time: '5 days' },
  { title: 'Speed rescue', desc: 'We find what slows your site and fix it, measured before and after.', time: '3 days' },
  { title: 'Bug fixing', desc: 'Broken links, errors and bugs found and fixed.', time: '1 day' },
  { title: 'Website care', desc: 'Updates, security checks and a speed watch, every month.', time: 'Monthly' },
];

// "Which one fits?": a recommendation per kind of business, each jumping to its plan
const guide = [
  {
    who: 'Opening a café, salon or studio',
    pick: 'System + Foundation',
    why: 'A look people remember, then a website they trust.',
    tab: 'branding',
    plan: 'System',
  },
  {
    who: 'Running a clinic, gym or practice',
    pick: 'Foundation or Powerhouse',
    why: 'A site people find on Google. Powerhouse when you need features like online booking.',
    tab: 'technology',
    plan: 'Powerhouse',
  },
  {
    who: 'Growing a brand or an online shop',
    pick: 'Engine or Overdrive',
    why: 'A steady stream of content and ads, measured and reported.',
    tab: 'marketing',
    plan: 'Overdrive',
  },
];

const industries = [
  'Barbers & hair',
  'Nails & beauty',
  'Car detailing',
  'Gyms & fitness',
  'Physio & health',
  'Massage & spa',
  'Dental & clinics',
  'Events & catering',
  'Restaurants & cafés',
  'E-commerce',
  'Real estate',
  'Education',
  'SaaS & startups',
  'Other',
];

const trust = ['First design in 48h', 'You own everything', 'No lock-in contracts', 'Replies within 24h'];
---

<section class="section packages" id="packages" aria-labelledby="packages-heading">
  <div class="container">
    <div class="pkg-head">
      <div>
        <p class="eyebrow" data-reveal>Packages</p>
        <h2 class="h-display h2" id="packages-heading" data-split-lines>
          Pick what you need. <em class="serif-i text-acid">We handle the rest.</em>
        </h2>
      </div>
      <p class="pkg-note" data-reveal>
        Websites, branding and marketing, in clear plans: who each one is for, what you get and what it does for
        your business. Every plan starts with a free 15-minute call, and everything we make is yours.
      </p>
    </div>

    <div class="pkg-guide" data-reveal>
      <p class="pkg-guide-k">Which one fits?</p>
      <ul class="pkg-guide-list">
        {
          guide.map((g) => (
            <li>
              <button type="button" class="pkg-fit" data-pkg-fit={g.tab} data-pkg-plan={g.plan}>
                <span class="pkg-fit-who">{g.who}</span>
                <span class="pkg-fit-pick">{g.pick}</span>
                <span class="pkg-fit-why">{g.why}</span>
                <span class="pkg-fit-go">
                  See the plan
                  <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
              </button>
            </li>
          ))
        }
        <li>
          <button type="button" class="pkg-fit pkg-fit-call on-light" data-pkg-select data-package="Free 15-minute call" data-category="Not sure yet">
            <span class="pkg-fit-who">Not sure yet?</span>
            <span class="pkg-fit-pick">Book the free 15-minute call</span>
            <span class="pkg-fit-why">Tell us about your business. We’ll tell you honestly what you need, and what you don’t.</span>
            <span class="pkg-fit-go">
              Book the call
              <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </span>
          </button>
        </li>
      </ul>
    </div>

    <div class="pkg-tabs" role="tablist" aria-label="Package categories" data-reveal>
      {
        tabs.map((t, i) => (
          <button
            class={`pkg-tab${i === 0 ? ' is-active' : ''}`}
            role="tab"
            id={`tab-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${t.id}`}
            data-pkg-tab={t.id}
          >
            {t.label} <sup>{t.count}</sup>
          </button>
        ))
      }
      <button class="pkg-tab" role="tab" id="tab-singles" aria-selected="false" aria-controls="panel-singles" data-pkg-tab="singles">
        One-off jobs <sup>12</sup>
      </button>
    </div>

    {
      tabs.map((t, i) => (
        <div class={`pkg-panel${i === 0 ? ' is-active' : ''}`} role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-pkg-panel={t.id}>
          <p class="pkg-blurb">{t.blurb}</p>
          <div class={`pkg-grid cols-${t.cards.length}`}>
            {t.cards.map((c) => (
              <article class={`pc${c.featured ? ' is-featured on-light' : ''}`} aria-labelledby={`pc-${c.title}`} data-pkg-card={c.title}>
                <header class="pc-head">
                  {c.badge && <span class="pc-badge">{c.badge}</span>}
                  <h3 class="pc-name" id={`pc-${c.title}`}>
                    {c.title}
                  </h3>
                  <p class="pc-what">{c.what}</p>
                </header>
                <dl class="pc-rows">
                  <div class="pc-row">
                    <dt>For</dt>
                    <dd>{c.forWho}</dd>
                  </div>
                  <div class="pc-row">
                    <dt>You get</dt>
                    <dd>
                      <ul class="pc-gets">
                        {c.gets.map((g) => (
                          <li>{g}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                  {c.timing && (
                    <div class="pc-row">
                      <dt>Timing</dt>
                      <dd>{c.timing}</dd>
                    </div>
                  )}
                  <div class="pc-row pc-result">
                    <dt>The result</dt>
                    <dd>{c.result}</dd>
                  </div>
                </dl>
                <button class="pc-cta" data-pkg-select data-package={c.title} data-category={t.category}>
                  <span>Talk about {c.title}</span>
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
              </article>
            ))}
          </div>
        </div>
      ))
    }

    <div class="pkg-panel" role="tabpanel" id="panel-singles" aria-labelledby="tab-singles" data-pkg-panel="singles">
      <p class="pkg-blurb">Need one thing done well? Pick a job, see how long it takes, book it.</p>
      <div class="single-grid">
        {
          singles.map((s) => (
            <article class="single-card">
              <div class="single-top">
                <h3 class="single-title">{s.title}</h3>
                <span class="single-time">{s.time}</span>
              </div>
              <p class="single-desc">{s.desc}</p>
              <button class="single-select" data-pkg-select data-package={s.title} data-category="À la carte">
                Book it →
              </button>
            </article>
          ))
        }
      </div>
    </div>

    <ul class="pkg-trust" data-reveal>
      {
        trust.map((tr) => (
          <li>
            <span class="trust-tick" aria-hidden="true">
              ✓
            </span>
            {tr}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pkg-modal" data-pkg-modal aria-hidden="true">
    <div class="pkg-modal-backdrop" data-pkg-close></div>
    <div class="pkg-modal-box" role="dialog" aria-modal="true" aria-labelledby="pkg-modal-title" data-lenis-prevent>
      <button class="pkg-modal-x" data-pkg-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>

      <div class="pkg-modal-form" data-modal-stage="form">
        <p class="eyebrow">Book a discovery call</p>
        <h3 class="pkg-modal-title" id="pkg-modal-title" data-modal-package>Package</h3>
        <span class="pkg-modal-cat" data-modal-category>Marketing</span>

        <form class="pkg-form" data-pkg-form novalidate>
          <div class="pkg-fields">
            <label class="pkg-field">
              <span>Full name *</span>
              <input type="text" name="name" placeholder="Your full name" required autocomplete="name" />
            </label>
            <label class="pkg-field">
              <span>Email address *</span>
              <input type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
            </label>
            <label class="pkg-field">
              <span>Phone / WhatsApp (optional)</span>
              <input type="tel" name="phone" placeholder="+49 151 0000 0000" autocomplete="tel" />
            </label>
            <div class="pkg-field">
              <span id="pkg-ind-label">Business industry *</span>
              <div class="dd" data-dd>
                <button
                  type="button"
                  class="dd-trigger"
                  data-dd-trigger
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="pkg-ind-label"
                >
                  <span class="dd-value is-placeholder" data-dd-value>Select industry</span>
                  <svg class="dd-chevron" width="11" height="7" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </button>
                <ul class="dd-panel" role="listbox" aria-labelledby="pkg-ind-label" data-dd-panel data-lenis-prevent>
                  {
                    industries.map((ind) => (
                      <li role="option" aria-selected="false" data-dd-option data-value={ind} tabindex="-1">
                        <span>{ind}</span>
                        <svg class="dd-tick" width="12" height="10" viewBox="0 0 12 10" fill="none" aria-hidden="true">
                          <path d="M1 5.5 4.5 9 11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </li>
                    ))
                  }
                </ul>
                <input type="hidden" name="industry" data-dd-input />
              </div>
            </div>
            <label class="pkg-field pkg-field-wide">
              <span>What are you building? (optional)</span>
              <textarea
                name="message"
                rows="3"
                placeholder="A sentence or two about your project, goals or deadline…"
              />
            </label>
            <input type="text" name="website" class="pkg-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </div>
          <button type="submit" class="btn btn-acid pkg-submit" data-pkg-submit>
            <span class="btn-fill"></span>
            <span data-submit-label>Send inquiry</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </button>
          <p class="pkg-form-note">
            We reply within 24 hours — usually much faster.
          </p>
          <p class="pkg-form-note pkg-form-privacy">
            We use your data only to answer your inquiry — see our
            <a href="/privacy/" target="_blank" rel="noopener">Privacy policy</a>.
          </p>
        </form>
      </div>

      <div class="pkg-modal-success" data-modal-stage="success" hidden>
        <span class="success-ring" aria-hidden="true">
          <svg viewBox="0 0 52 52" fill="none">
            <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.4" />
            <path d="M15 27l8 8 15-16" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <h3 class="success-title">Got it. You're on our radar.</h3>
        <p class="success-text">
          Your inquiry for <b data-success-package>—</b> just landed in our inbox, and a
          confirmation is on its way to your email. Expect a real human reply within 24 hours.
        </p>
        <button class="btn btn-ghost success-close" data-pkg-close>
          <span class="btn-fill"></span>
          <span>Back to the site</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('packages');

  /* ---- tabs ---- */
  const tabButtons = section.querySelectorAll('[data-pkg-tab]');
  const panels = section.querySelectorAll('[data-pkg-panel]');

  const activate = (id) => {
    tabButtons.forEach((b) => {
      const on = b.getAttribute('data-pkg-tab') === id;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach((p) => {
      p.classList.toggle('is-active', p.getAttribute('data-pkg-panel') === id);
    });
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => activate(btn.getAttribute('data-pkg-tab')));
  });

  /* ---- which one fits: open the right tab and point at the plan ---- */
  section.querySelectorAll('[data-pkg-fit]').forEach((tile) => {
    tile.addEventListener('click', () => {
      activate(tile.getAttribute('data-pkg-fit'));
      const card = section.querySelector(`[data-pkg-card="${tile.getAttribute('data-pkg-plan')}"]`);
      if (!card) return;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      card.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      setTimeout(() => card.classList.remove('is-flash'), 1800);
      card.querySelector('[data-pkg-select]')?.focus({ preventScroll: true });
    });
  });

  /* ---- modal ---- */
  const modal = section.querySelector('[data-pkg-modal]');
  const stageForm = section.querySelector('[data-modal-stage="form"]');
  const stageSuccess = section.querySelector('[data-modal-stage="success"]');
  const modalPackage = section.querySelector('[data-modal-package]');
  const modalCategory = section.querySelector('[data-modal-category]');
  const successPackage = section.querySelector('[data-success-package]');
  const form = section.querySelector('[data-pkg-form]');
  const submitBtn = section.querySelector('[data-pkg-submit]');
  const submitLabel = section.querySelector('[data-submit-label]');
  let lastFocus = null;

  const openModal = (pkg, cat) => {
    modalPackage.textContent = pkg;
    modalCategory.textContent = cat;
    stageForm.hidden = false;
    stageSuccess.hidden = true;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('modal-open');
    window.dispatchEvent(new CustomEvent('lenis:stop'));
    lastFocus = document.activeElement;
    // Autofocus only where a hardware keyboard is likely — on phones it
    // would slam the keyboard open over the sheet.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const first = form.querySelector('input');
      if (first) setTimeout(() => first.focus(), 80);
    }
  };

  const closeModal = () => {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('modal-open');
    window.dispatchEvent(new CustomEvent('lenis:start'));
    if (lastFocus) lastFocus.focus();
  };

  section.querySelectorAll('[data-pkg-select]').forEach((btn) => {
    btn.addEventListener('click', () => {
      openModal(btn.getAttribute('data-package'), btn.getAttribute('data-category'));
    });
  });

  section.querySelectorAll('[data-pkg-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  /* ---- custom industry dropdown ---- */
  const dd = section.querySelector('[data-dd]');
  const ddTrigger = dd.querySelector('[data-dd-trigger]');
  const ddPanel = dd.querySelector('[data-dd-panel]');
  const ddValue = dd.querySelector('[data-dd-value]');
  const ddInput = dd.querySelector('[data-dd-input]');
  const ddOptions = [...dd.querySelectorAll('[data-dd-option]')];
  let ddFocusIndex = -1;

  const ddSetFocus = (i) => {
    ddFocusIndex = (i + ddOptions.length) % ddOptions.length;
    ddOptions.forEach((o, j) => o.classList.toggle('is-focused', j === ddFocusIndex));
    ddOptions[ddFocusIndex].scrollIntoView({ block: 'nearest' });
  };

  const ddOpen = () => {
    // Flip upward when there's not enough room below inside the modal box.
    const box = dd.closest('.pkg-modal-box');
    const spaceBelow = box.getBoundingClientRect().bottom - dd.getBoundingClientRect().bottom;
    dd.classList.toggle('drop-up', spaceBelow < 240);
    dd.classList.add('is-open');
    ddTrigger.setAttribute('aria-expanded', 'true');
    const selected = ddOptions.findIndex((o) => o.getAttribute('aria-selected') === 'true');
    ddSetFocus(selected >= 0 ? selected : 0);
  };

  const ddClose = (refocus = true) => {
    dd.classList.remove('is-open');
    ddTrigger.setAttribute('aria-expanded', 'false');
    if (refocus) ddTrigger.focus();
  };

  const ddSelect = (i) => {
    const opt = ddOptions[i];
    ddOptions.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
    ddInput.value = opt.getAttribute('data-value');
    ddValue.textContent = opt.getAttribute('data-value');
    ddValue.classList.remove('is-placeholder');
    dd.classList.remove('is-error');
    ddClose();
  };

  const ddReset = () => {
    ddOptions.forEach((o) => o.setAttribute('aria-selected', 'false'));
    ddInput.value = '';
    ddValue.textContent = 'Select industry';
    ddValue.classList.add('is-placeholder');
    dd.classList.remove('is-error', 'is-open');
  };

  ddTrigger.addEventListener('click', () => {
    dd.classList.contains('is-open') ? ddClose() : ddOpen();
  });

  ddOptions.forEach((opt, i) => {
    opt.addEventListener('click', () => ddSelect(i));
    opt.addEventListener('pointerenter', () => ddSetFocus(i));
  });

  dd.addEventListener('keydown', (e) => {
    const open = dd.classList.contains('is-open');
    if (e.key === 'Escape' && open) {
      e.stopPropagation();
      ddClose();
      return;
    }
    if (!open && ['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
      e.preventDefault();
      ddOpen();
      return;
    }
    if (!open) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      ddSetFocus(ddFocusIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      ddSetFocus(ddFocusIndex - 1);
    } else if (e.key === 'Home') {
      e.preventDefault();
      ddSetFocus(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      ddSetFocus(ddOptions.length - 1);
    } else if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (ddFocusIndex >= 0) ddSelect(ddFocusIndex);
    } else if (e.key === 'Tab') {
      ddClose(false);
    } else if (/^[a-z]$/i.test(e.key)) {
      const hit = ddOptions.findIndex((o) =>
        o.getAttribute('data-value').toLowerCase().startsWith(e.key.toLowerCase())
      );
      if (hit >= 0) ddSetFocus(hit);
    }
  });

  document.addEventListener('pointerdown', (e) => {
    if (dd.classList.contains('is-open') && !dd.contains(e.target)) ddClose(false);
  });

  /* ---- submit: Resend endpoint, mailto as a last-resort fallback ---- */
  const mailtoFallback = (data, pkg, cat) => {
    const subject = `Discovery call — ${pkg}`;
    const body = [
      `Package: ${pkg} (${cat})`,
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      `Phone: ${data.get('phone') || '—'}`,
      `Industry: ${data.get('industry')}`,
      `Message: ${data.get('message') || '—'}`,
    ].join('\n');
    window.location.href = `mailto:contact@devstudiocraft.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!ddInput.value) {
      dd.classList.add('is-error');
      ddTrigger.focus();
      return;
    }
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const pkg = modalPackage.textContent;
    const cat = modalCategory.textContent;

    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending…';

    try {
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          packageName: pkg,
          category: cat,
          name: data.get('name'),
          email: data.get('email'),
          phone: data.get('phone'),
          industry: data.get('industry'),
          message: data.get('message') || '',
          website: data.get('website') || '',
        }),
      });
      const out = await res.json().catch(() => ({ ok: false }));

      if (out.ok) {
        successPackage.textContent = pkg;
        stageForm.hidden = true;
        stageSuccess.hidden = false;
        form.reset();
        ddReset();
      } else {
        mailtoFallback(data, pkg, cat);
      }
    } catch {
      mailtoFallback(data, pkg, cat);
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send inquiry';
    }
  });
</script>

