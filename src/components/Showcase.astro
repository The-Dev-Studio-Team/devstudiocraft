---
import { Image } from 'astro:assets';
import artCommerce from '../assets/gen/card-commerce.jpg';
import artLaunch from '../assets/gen/card-launch.jpg';
import artIdentity from '../assets/gen/card-identity.jpg';
import artProduct from '../assets/gen/card-product.jpg';

const cards = [
  {
    key: 'shop',
    n: '001',
    title: 'Commerce',
    line: 'Full-funnel stores with custom checkout flows.',
    tags: ['Storefront', 'CRO', 'Payments'],
    theme: 'theme-acid',
    art: artCommerce,
  },
  {
    key: 'launch',
    n: '002',
    title: 'Launch',
    line: 'Campaign landing pages that convert from day one.',
    tags: ['Landing', 'Speed', 'Analytics'],
    theme: 'theme-violet',
    art: artLaunch,
  },
  {
    key: 'brand',
    n: '003',
    title: 'Identity',
    line: 'Brand systems built to scale across every channel.',
    tags: ['Logo', 'System', 'Voice'],
    theme: 'theme-ember',
    art: artIdentity,
  },
  {
    key: 'app',
    n: '004',
    title: 'Product',
    line: 'Web & mobile apps your users come back to.',
    tags: ['iOS', 'Android', 'Web app'],
    theme: 'theme-ice',
    art: artProduct,
  },
];
---

<section class="showcase" id="work" aria-labelledby="work-heading">
  <div class="showcase-pin" data-showcase-pin>
    <div class="container showcase-head">
      <p class="eyebrow" data-reveal>Capabilities</p>
      <h2 class="h-display h2" id="work-heading" data-split-lines>
        Built for every way <em class="serif-i text-acid">you sell.</em>
      </h2>
    </div>

    <div class="showcase-track" data-showcase-track>
      {
        cards.map((c) => (
          <article class={`show-card ${c.theme}`} data-cursor="Drag">
            <div class="show-card-art" aria-hidden="true">
              <Image
                class="art-img"
                src={c.art}
                alt=""
                width={640}
                densities={[1, 2]}
                quality={72}
                loading="lazy"
              />
              <div class="art-glow" />
              <div class="art-grid" />

              {
                c.key === 'shop' && (
                  <div class="vig" data-vig="shop">
                    <div class="shop-head">
                      <span class="shop-name">AURA · STORE</span>
                      <span class="cart-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                          <path d="M3 4h2l2.4 12.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2" />
                          <circle cx="9.5" cy="20" r="1.4" fill="currentColor" stroke="none" />
                          <circle cx="17" cy="20" r="1.4" fill="currentColor" stroke="none" />
                        </svg>
                        <span class="cart-badge" data-cart-badge>1</span>
                      </span>
                    </div>
                    <div class="prod" data-prod>
                      <span class="prod-img" />
                      <span class="prod-info">
                        <b class="prod-name">Studio Hoodie</b>
                        <span class="prod-stars">★★★★★ <em>212</em></span>
                        <span class="prod-price">$64.00</span>
                      </span>
                      <span class="prod-add" data-prod-add>Add</span>
                    </div>
                    <div class="shop-foot">
                      <span class="shop-total">
                        Total <b data-shop-total>$64.00</b>
                      </span>
                      <span class="shop-cta" data-shop-cta>
                        <i class="cta-fill" data-cta-fill />
                        <span>Checkout</span>
                      </span>
                    </div>
                    <span class="vig-toast" data-shop-toast>Order #2481 confirmed ✓</span>
                  </div>
                )
              }

              {
                c.key === 'launch' && (
                  <div class="vig" data-vig="launch">
                    <div class="dep-head">
                      <span class="dep-url">campaign.yourbrand.com</span>
                      <span class="vig-chip" data-l-live>LIVE</span>
                    </div>
                    <ul class="dep-steps">
                      <li class="is-done" data-dep-step>
                        <i class="dep-dot" />
                        <span>Design & build</span>
                        <b class="dep-check">✓</b>
                      </li>
                      <li class="is-done" data-dep-step>
                        <i class="dep-dot" />
                        <span>Deploy to edge</span>
                        <b class="dep-check">✓</b>
                      </li>
                      <li class="is-done" data-dep-step>
                        <i class="dep-dot" />
                        <span>Domain connected</span>
                        <b class="dep-check">✓</b>
                      </li>
                    </ul>
                    <div class="dep-stats">
                      <span class="dep-visitors">
                        <b data-dep-count>1,284</b> visitors today
                      </span>
                      <svg class="dep-spark" viewBox="0 0 120 36" fill="none">
                        <polyline
                          data-l-spark
                          points="2,32 20,27 38,29 56,20 74,22 94,10 118,3"
                          stroke="currentColor"
                          stroke-width="2.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </div>
                  </div>
                )
              }

              {
                c.key === 'brand' && (
                  <div class="vig" data-vig="brand">
                    <div class="br-word" data-br-word>
                      <span>A</span><span>U</span><span>R</span><span>A</span>
                    </div>
                    <span class="br-tag" data-br-tag>Brand identity system — v2.0</span>
                    <div class="br-swatches">
                      <i data-b-swatch style="--sw: #ff8a50">
                        <em>#FF8A50</em>
                      </i>
                      <i data-b-swatch style="--sw: #b85e33">
                        <em>#B85E33</em>
                      </i>
                      <i data-b-swatch class="sw-light" style="--sw: #f2efe8">
                        <em>#F2EFE8</em>
                      </i>
                      <i data-b-swatch style="--sw: #16161d">
                        <em>#16161D</em>
                      </i>
                    </div>
                    <div class="br-type" data-br-type>
                      <span class="br-aa">Aa</span>
                      <span class="br-fonts">
                        <b>Clash Display</b>
                        <small>Satoshi · body</small>
                      </span>
                    </div>
                  </div>
                )
              }

              {
                c.key === 'app' && (
                  <div class="vig" data-vig="app">
                    <div class="phone">
                      <div class="ph-status">
                        <span>9:41</span>
                        <span class="ph-sig">
                          <i /><i /><i />
                        </span>
                      </div>
                      <div class="ph-view">
                        <div class="ph-screens" data-ph-screens>
                          <div class="scr scr-home">
                            <span class="app-label">Total balance</span>
                            <b class="app-balance" data-app-balance>$8,240</b>
                            <span class="app-delta">▲ 12% this week</span>
                            <span class="scr-chart">
                              <i style="--h: 42%" />
                              <i style="--h: 70%" />
                              <i style="--h: 54%" />
                              <i style="--h: 92%" />
                              <i style="--h: 66%" />
                            </span>
                          </div>
                          <div class="scr scr-activity">
                            <span class="app-label">Activity</span>
                            <div class="act-row">
                              <i class="act-av" />
                              <span class="act-info">
                                <b>Sara M.</b>
                                <small>2 min ago</small>
                              </span>
                              <span class="act-amt">+$120</span>
                            </div>
                            <div class="act-row">
                              <i class="act-av av-b" />
                              <span class="act-info">
                                <b>Order #2481</b>
                                <small>1 hr ago</small>
                              </span>
                              <span class="act-amt">+$64</span>
                            </div>
                            <div class="act-row">
                              <i class="act-av av-c" />
                              <span class="act-info">
                                <b>Payout</b>
                                <small>Yesterday</small>
                              </span>
                              <span class="act-amt dim">$1,900</span>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="ph-tab">
                        <i data-ph-dot class="is-on" />
                        <i data-ph-dot />
                      </div>
                    </div>
                    <span class="vig-chip" data-app-notif>+$120 received</span>
                  </div>
                )
              }
            </div>
            <div class="show-card-body">
              <span class="show-card-n">{c.n}</span>
              <h3 class="show-card-title">{c.title}</h3>
              <p class="show-card-line">{c.line}</p>
              <div class="show-card-tags">
                {c.tags.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
      <article class="show-card show-card-cta theme-ink">
        <a href="#contact" class="show-cta-link" data-cursor="Start">
          <span class="h-display">Your project<br />goes <em class="serif-i text-acid">here.</em></span>
          <span class="show-cta-arrow" aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .showcase {
    background: var(--bg-soft);
    border-block: 1px solid var(--line);
    overflow: clip;
  }

  .showcase-pin {
    min-height: 100svh;
    padding-block: clamp(2rem, 5vh, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 4.5vh, 3.5rem);
  }

  .showcase-head {
    display: grid;
    gap: 1.8rem;
    max-width: 56rem;
    margin-right: auto;
  }

  .showcase-track {
    display: flex;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    padding-inline: var(--gutter);
    width: max-content;
    will-change: transform;
  }

  .show-card {
    width: clamp(17rem, 30vw, 24rem);
    aspect-ratio: 3 / 3.6;
    max-height: 60vh;
    border-radius: 1.4rem;
    border: 1px solid var(--line);
    background: var(--bg-card);
    position: relative;
    overflow: clip;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform 0.6s var(--ease-expo), border-color 0.6s var(--ease-expo);
  }

  .show-card:hover {
    transform: translateY(-0.6rem);
    border-color: var(--ink-faint);
  }

  .show-card-art {
    position: absolute;
    inset: 0;
  }

  .show-card-art :global(.art-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    opacity: 0.5;
    transform: scale(1.02);
    transition: transform 1s var(--ease-expo);
  }

  .show-card:hover .show-card-art :global(.art-img) {
    transform: scale(1.08);
  }

  /* ---- vignette theme accents ---- */
  .theme-acid {
    --vc: #c9f24b;
    --vc-ink: #0c0e04;
  }

  .theme-violet {
    --vc: #a48bff;
    --vc-ink: #140b33;
  }

  .theme-ember {
    --vc: #ff8a50;
    --vc-ink: #2b1206;
  }

  .theme-ice {
    --vc: #6fd3ff;
    --vc-ink: #06222e;
  }

  /* ---- animated vignettes ---- */
  .vig {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    pointer-events: none;
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem;
    background: rgba(11, 11, 14, 0.62);
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    backdrop-filter: blur(8px);
  }

  .vig-chip,
  .vig-toast {
    position: absolute;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.62rem;
    border-radius: 100px;
    background: var(--vc);
    color: var(--vc-ink);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--vc) 30%, transparent);
    white-space: nowrap;
  }

  /* -- shop -- */
  .shop-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .shop-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--ink-dim);
  }

  .cart-wrap {
    position: relative;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--ink-dim);
  }

  .cart-wrap svg {
    width: 100%;
    height: 100%;
  }

  .cart-badge {
    position: absolute;
    top: -0.42rem;
    right: -0.52rem;
    min-width: 0.92rem;
    height: 0.92rem;
    display: grid;
    place-items: center;
    font-size: 0.55rem;
    font-weight: 700;
    border-radius: 100px;
    background: var(--vc);
    color: var(--vc-ink);
  }

  .prod {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: rgba(18, 18, 24, 0.92);
    padding: 0.5rem;
  }

  .prod-img {
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    border-radius: 0.45rem;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 25%, rgba(242, 239, 232, 0.28), transparent 45%),
      linear-gradient(135deg, color-mix(in srgb, var(--vc) 45%, transparent), rgba(20, 20, 26, 0.9));
  }

  .prod-info {
    flex: 1;
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .prod-name {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink);
  }

  .prod-stars {
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    color: var(--vc);
  }

  .prod-stars em {
    font-style: normal;
    color: var(--ink-faint);
  }

  .prod-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--ink);
  }

  .prod-add {
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.32rem 0.7rem;
    border-radius: 100px;
    background: var(--vc);
    color: var(--vc-ink);
  }

  .shop-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .shop-total {
    font-size: 0.6rem;
    color: var(--ink-faint);
  }

  .shop-total b {
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--ink);
    margin-left: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .shop-cta {
    position: relative;
    overflow: clip;
    border: 1px solid color-mix(in srgb, var(--vc) 55%, transparent);
    border-radius: 100px;
    padding: 0.32rem 0.9rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--vc-ink);
  }

  .shop-cta span {
    position: relative;
  }

  .cta-fill {
    position: absolute;
    inset: 0;
    background: var(--vc);
    transform-origin: left center;
  }

  .vig-toast {
    bottom: -1.1rem;
    left: 50%;
    translate: -50% 0;
  }

  /* -- launch: deploy console -- */
  .dep-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .dep-url {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.18rem 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  [data-vig='launch'] .vig-chip {
    position: static;
    flex-shrink: 0;
  }

  .dep-steps {
    list-style: none;
    display: grid;
    gap: 0.34rem;
  }

  .dep-steps li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: rgba(18, 18, 24, 0.9);
    padding: 0.3rem 0.55rem;
  }

  .dep-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: rgba(242, 239, 232, 0.25);
    flex-shrink: 0;
  }

  .dep-steps li.is-done .dep-dot {
    background: var(--vc);
    box-shadow: 0 0 8px color-mix(in srgb, var(--vc) 60%, transparent);
  }

  .dep-steps li span {
    flex: 1;
  }

  .dep-check {
    color: var(--vc);
    font-size: 0.66rem;
    opacity: 0;
  }

  .dep-steps li.is-done .dep-check {
    opacity: 1;
  }

  .dep-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .dep-visitors {
    font-size: 0.58rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .dep-visitors b {
    font-family: var(--font-display);
    font-size: 0.82rem;
    color: var(--ink);
    margin-right: 0.2rem;
    font-variant-numeric: tabular-nums;
  }

  .dep-spark {
    width: 42%;
    color: var(--vc);
    flex-shrink: 0;
  }

  /* -- brand: identity board -- */
  .br-word {
    display: flex;
    overflow: clip;
    padding-block: 0.04em;
    gap: 0.06em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--ink);
    letter-spacing: 0.04em;
  }

  .br-word span {
    display: inline-block;
  }

  .br-word span:first-child {
    color: var(--vc);
  }

  .br-tag {
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .br-swatches {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .br-swatches i {
    flex: 1;
    height: 1.9rem;
    border-radius: 0.4rem;
    background: var(--sw);
    border: 1px solid var(--line);
    display: grid;
    align-content: end;
    padding: 0.18rem 0.25rem;
  }

  .br-swatches em {
    font-style: normal;
    font-size: 0.4rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(242, 239, 232, 0.85);
  }

  .br-swatches .sw-light em {
    color: rgba(11, 11, 14, 0.7);
  }

  .br-type {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .br-aa {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--vc);
  }

  .br-fonts {
    display: grid;
    gap: 0.05rem;
  }

  .br-fonts b {
    font-family: var(--font-display);
    font-size: 0.62rem;
    color: var(--ink);
  }

  .br-fonts small {
    font-size: 0.52rem;
    color: var(--ink-faint);
  }

  /* -- app -- */
  [data-vig='app'] {
    justify-items: stretch;
  }

  .phone {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: rgba(16, 16, 21, 0.95);
    padding: 0.5rem 0.5rem 0.6rem;
    display: grid;
    gap: 0.4rem;
  }

  .ph-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.15rem;
    font-size: 0.5rem;
    font-weight: 700;
    color: var(--ink-dim);
  }

  .ph-sig {
    display: flex;
    gap: 0.14rem;
    align-items: end;
  }

  .ph-sig i {
    width: 0.16rem;
    border-radius: 1px;
    background: var(--ink-dim);
  }

  .ph-sig i:nth-child(1) {
    height: 0.22rem;
  }

  .ph-sig i:nth-child(2) {
    height: 0.32rem;
  }

  .ph-sig i:nth-child(3) {
    height: 0.42rem;
  }

  .ph-view {
    overflow: clip;
    border-radius: 0.5rem;
  }

  .ph-screens {
    display: flex;
    width: 100%;
  }

  .scr {
    flex: 0 0 100%;
    height: 6.1rem;
    background: rgba(11, 11, 14, 0.92);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.5rem;
    display: grid;
    gap: 0.28rem;
    align-content: start;
  }

  .app-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .app-balance {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .app-delta {
    font-size: 0.52rem;
    font-weight: 700;
    color: var(--vc);
  }

  .scr-chart {
    display: flex;
    align-items: end;
    gap: 0.24rem;
    height: 2.2rem;
    margin-top: 0.15rem;
  }

  .scr-chart i {
    flex: 1;
    height: var(--h);
    border-radius: 0.18rem 0.18rem 0 0;
    background: linear-gradient(180deg, var(--vc), color-mix(in srgb, var(--vc) 35%, transparent));
    transform-origin: bottom center;
  }

  .act-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .act-av {
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--vc) 60%, transparent), rgba(242, 239, 232, 0.12));
    flex-shrink: 0;
  }

  .act-av.av-b {
    background: linear-gradient(135deg, rgba(201, 242, 75, 0.5), rgba(242, 239, 232, 0.1));
  }

  .act-av.av-c {
    background: linear-gradient(135deg, rgba(164, 139, 255, 0.5), rgba(242, 239, 232, 0.1));
