---
import { Image } from 'astro:assets';
import edgeTemplates from '../assets/gen/edge-templates.jpg';
import edgeLine from '../assets/gen/edge-line.jpg';
import edgeFast from '../assets/gen/edge-fast.jpg';
import edgeCanyon from '../assets/gen/edge-canyon.jpg';
---

<section class="section edge" id="edge" aria-labelledby="edge-heading">
  <div class="container">
    <div class="edge-head">
      <p class="eyebrow" data-reveal>Why DevStudioCraft</p>
      <h2 class="h-display h2" id="edge-heading" data-split-lines>
        The unfair <em class="serif-i text-acid">advantage.</em>
      </h2>
    </div>

    <div class="bento">
      <article class="cell cell-big" data-reveal>
        <div class="cell-media" aria-hidden="true">
          <Image
            class="canyon-img"
            src={edgeCanyon}
            alt=""
            width={1400}
            densities={[1, 1.5]}
            quality={74}
            loading="lazy"
          />
          <div class="mist mist-a"></div>
          <div class="mist mist-b"></div>
          <div class="cell-media-scrim"></div>
        </div>

        <div class="race" aria-hidden="true" data-race>
          <div class="race-track">
            <div class="mini">
              <div class="mini-top">
                <i></i><i></i><i></i>
                <span class="mini-url">everyone-else.com</span>
              </div>
              <div class="mini-body">
                <span class="skel" style="--w: 42%"></span>
                <span class="skel" style="--w: 86%"></span>
                <span class="skel" style="--w: 68%"></span>
                <span class="skel" style="--w: 55%"></span>
                <span class="mini-spin" data-race-spin></span>
              </div>
              <span class="race-chip chip-bad" data-race-leave>Visitor gave up</span>
              <p class="race-cap"><span data-race-timer>6.0s</span> · still loading</p>
            </div>
            <div class="mini mini-fast">
              <div class="mini-top">
                <i></i><i></i><i></i>
                <span class="mini-url">yourbrand.com</span>
              </div>
              <div class="mini-body">
                <span class="mf mf-logo" data-race-el></span>
                <span class="mf mf-h1" data-race-el></span>
                <span class="mf mf-h2" data-race-el></span>
                <span class="mf mf-img" data-race-el></span>
                <span class="mf mf-cta" data-race-el></span>
              </div>
              <span class="race-chip chip-good" data-race-sale>New order · just now</span>
              <p class="race-cap race-cap-good"><strong>0.4s</strong> · already selling</p>
            </div>
          </div>
          <p class="race-note">
            Every extra second of loading costs you roughly <strong>7% of your sales</strong>.
            Your site will never pay that tax.
          </p>
        </div>

        <h3>Fast sites sell more</h3>
        <p>
          People decide in seconds. Your site shows up instantly, feels effortless on any
          phone, and turns attention into orders — while slower competitors watch customers
          walk away.
        </p>
      </article>

      <article class="cell cell-visual" data-reveal>
        <Image
          class="cell-bg"
          src={edgeTemplates}
          alt=""
          width={640}
          densities={[1, 2]}
          quality={70}
          loading="lazy"
        />
        <div class="cell-media-scrim" aria-hidden="true"></div>
        <span class="cell-stat">0</span>
        <h3>Templates used</h3>
        <p>Everything is designed and coded for your brand. You own the stack — no lock-in.</p>
      </article>

      <article class="cell cell-visual" data-reveal>
        <Image
          class="cell-bg"
          src={edgeLine}
          alt=""
          width={640}
          densities={[1, 2]}
          quality={70}
          loading="lazy"
        />
        <div class="cell-media-scrim" aria-hidden="true"></div>
        <span class="cell-stat">1:1</span>
        <h3>Direct line to the builders</h3>
        <p>No account managers, no telephone game. You talk to the people doing the work.</p>
      </article>

      <article class="cell cell-visual" data-reveal>
        <Image
          class="cell-bg"
          src={edgeFast}
          alt=""
          width={640}
          densities={[1, 2]}
          quality={70}
          loading="lazy"
        />
        <div class="cell-media-scrim" aria-hidden="true"></div>
        <span class="cell-stat">48h</span>
        <h3>First concept, fast</h3>
        <p>A visual direction on your screen within two days of kickoff. Momentum from day one.</p>
      </article>

      <article class="cell cell-acid" data-reveal>
        <h3>Design that converts</h3>
        <p>
          Award-level craft in service of one metric: revenue. Motion, story and psychology —
          all aimed at the buy button.
        </p>
        <a href="#contact" class="cell-link">Let's talk →</a>
      </article>
    </div>
  </div>
</section>

<style>
  .edge {
    background: var(--bg-soft);
    border-block: 1px solid var(--line);
  }

  .edge-head {
    display: grid;
    gap: 1.8rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 56rem;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .cell {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 1.4rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    position: relative;
    overflow: clip;
    transition: border-color 0.5s var(--ease-expo), transform 0.5s var(--ease-expo);
  }

  .cell:hover {
    border-color: var(--ink-faint);
    transform: translateY(-4px);
  }

  .cell-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cell-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .cell-media-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 11, 14, 0.72) 0%,
      rgba(11, 11, 14, 0.38) 45%,
      rgba(11, 11, 14, 0.86) 100%
    );
  }

  .cell h3,
  .cell p,
  .cell .cell-stat,
  .cell .cell-link {
    position: relative;
    z-index: 1;
  }

  .cell :global(.cell-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
    transform: scale(1.02);
    transition:
      opacity 0.6s var(--ease-expo),
      transform 0.9s var(--ease-expo);
  }

  .cell-visual:hover :global(.cell-bg) {
    opacity: 0.62;
    transform: scale(1.07);
  }

  @media (prefers-reduced-motion: reduce), (max-width: 760px) {
    .cell-media video {
      display: none;
    }
  }

  .cell h3 {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .cell p {
    color: var(--ink-dim);
    font-size: 0.95rem;
    text-wrap: pretty;
  }

  .cell-stat {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 2rem + 2.4vw, 4.4rem);
    line-height: 0.9;
    color: var(--acid);
  }

  .cell-big {
    grid-column: span 2;
    grid-row: span 2;
    justify-content: flex-end;
    min-height: 28rem;
    gap: 1.1rem;
  }

  .cell-big h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    max-width: 20ch;
  }

  .cell-big p {
    max-width: 40rem;
    font-size: 1.02rem;
  }

  .cell-big {
    background-image:
      linear-gradient(rgba(242, 239, 232, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 239, 232, 0.035) 1px, transparent 1px);
    background-size: 2.6rem 2.6rem;
    background-position: center;
  }

  .cell-media :global(.canyon-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
    animation: canyon-drift 36s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes canyon-drift {
    from {
      transform: scale(1.05) translate3d(-1.2%, 0.8%, 0);
    }
    to {
      transform: scale(1.16) translate3d(1.4%, -1.2%, 0);
    }
  }

  .mist {
    position: absolute;
    width: 70%;
    height: 55%;
    border-radius: 50%;
    filter: blur(46px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  .mist-a {
    left: -12%;
    bottom: -8%;
    background: radial-gradient(ellipse at center, rgba(201, 242, 75, 0.13), transparent 68%);
    animation: mist-a 28s ease-in-out infinite alternate;
  }

  .mist-b {
    right: -15%;
    bottom: 6%;
    background: radial-gradient(ellipse at center, rgba(180, 200, 210, 0.1), transparent 68%);
    animation: mist-b 34s ease-in-out infinite alternate;
  }

  @keyframes mist-a {
    to {
      transform: translate3d(26%, -8%, 0) scale(1.18);
    }
  }

  @keyframes mist-b {
    to {
      transform: translate3d(-24%, -5%, 0) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell-media :global(.canyon-img),
    .mist {
      animation: none;
    }
  }

  /* ---- speed race demo ---- */
  .race {
    position: relative;
    z-index: 1;
    margin-bottom: auto;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgba(11, 11, 14, 0.58);
    backdrop-filter: blur(8px);
  }

  .race-track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }

  .mini {
    position: relative;
  }

  .mini-top {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line);
    border-bottom: none;
    border-radius: 0.7rem 0.7rem 0 0;
    background: rgba(22, 22, 29, 0.9);
  }

  .mini-top i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(242, 239, 232, 0.18);
  }

  .mini-fast .mini-top i:first-child {
    background: var(--acid);
  }

  .mini-url {
    margin-left: 0.45rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.12rem 0.55rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-fast .mini-url {
    color: var(--ink-dim);
  }

  .mini-body {
    position: relative;
    height: clamp(6.4rem, 9vw, 8rem);
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0 0 0.7rem 0.7rem;
    background: rgba(16, 16, 21, 0.92);
    display: grid;
    gap: 0.5rem;
    align-content: start;
    overflow: clip;
  }

  .skel {
    display: block;
    width: var(--w, 60%);
    height: 0.55rem;
    border-radius: 100px;
    background: linear-gradient(
      90deg,
      rgba(242, 239, 232, 0.07) 25%,
      rgba(242, 239, 232, 0.15) 50%,
      rgba(242, 239, 232, 0.07) 75%
    );
    background-size: 200% 100%;
    animation: skel-shimmer 1.7s linear infinite;
  }

  @keyframes skel-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  .mini-spin {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    border: 2px solid rgba(242, 239, 232, 0.14);
    border-top-color: rgba(242, 239, 232, 0.55);
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .mf {
    display: block;
    border-radius: 100px;
  }

  .mf-logo {
    width: 1.9rem;
    height: 0.5rem;
    background: var(--acid);
  }

  .mf-h1 {
    width: 78%;
    height: 0.68rem;
    background: rgba(242, 239, 232, 0.92);
  }

  .mf-h2 {
    width: 52%;
    height: 0.68rem;
    background: rgba(242, 239, 232, 0.55);
  }

  .mf-img {
    width: 100%;
    height: 2.1rem;
    border-radius: 0.45rem;
    border: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(201, 242, 75, 0.22), rgba(139, 106, 255, 0.22));
  }

  .mf-cta {
    width: 44%;
    height: 0.8rem;
    background: var(--acid);
  }

  .race-chip {
    position: absolute;
    top: -0.6rem;
    right: -0.35rem;
    z-index: 2;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.32rem 0.65rem;
    border-radius: 100px;
    white-space: nowrap;
  }

  .chip-good {
    background: var(--acid);
    color: var(--acid-ink);
    box-shadow: 0 8px 24px rgba(201, 242, 75, 0.25);
  }

  .chip-bad {
    background: #26262e;
    color: rgba(242, 239, 232, 0.7);
    border: 1px solid var(--line);
  }

  .race-cap {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .race-cap-good {
    color: var(--ink-dim);
  }

  .race-cap-good strong {
    color: var(--acid);
  }

  .race-note {
    margin-top: 0.95rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ink-dim);
  }

  .race-note strong {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .mini-url {
      display: none;
    }

    .race-chip {
      right: 0.3rem;
    }
  }

  .cell-acid {
    grid-column: span 2;
    background: var(--acid);
    border-color: var(--acid);
    color: var(--acid-ink);
  }

  .cell-acid p {
    color: rgba(12, 14, 4, 0.72);
  }

  .cell-link {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.95rem;
    width: fit-content;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 0.15rem;
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .cell-big {
      grid-column: auto;
      grid-row: auto;
      min-height: 20rem;
    }

    .cell-acid {
      grid-column: auto;
    }
  }
</style>
