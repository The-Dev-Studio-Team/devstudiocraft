---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  film: string;
  host: string;
  poster: ImageMetadata;
  alt: string;
  class?: string;
}

const { film, host, poster, alt, class: className } = Astro.props;
---

<div class:list={['browser', className]}>
  <div class="browser-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span class="browser-url">{host}</span>
    <span class="browser-live"><b></b>Live</span>
  </div>
  <div class="browser-view">
    <Image class="browser-poster" src={poster} alt={alt} width={900} densities={[1, 1.5]} quality={76} loading="lazy" />
    <video class="browser-film" muted loop playsinline preload="none" aria-hidden="true" data-film>
      <source src={`/media/work/film-${film}.webm`} type="video/webm" />
      <source src={`/media/work/film-${film}.mp4`} type="video/mp4" />
    </video>
    <span class="browser-progress" aria-hidden="true"><i data-progress></i></span>
  </div>
</div>

<style>
  .browser {
    border-radius: 0.9rem;
    overflow: clip;
    border: 1px solid rgba(242, 239, 232, 0.14);
    background: #0f0f13;
    box-shadow:
      0 40px 90px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: #17171d;
    border-bottom: 1px solid var(--line);
  }

  .browser-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(242, 239, 232, 0.16);
  }

  .browser-url {
    margin-inline: auto;
    padding: 0.2rem 1.2rem;
    border-radius: 100px;
    background: rgba(242, 239, 232, 0.06);
    font-size: 0.72rem;
    color: var(--ink-dim);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .browser-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .browser-live b {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--acid);
  }

  /* the pulse is a ring that scales and fades (compositor only), and only while the film plays */
  .browser-live b::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(201, 242, 75, 0.6);
    opacity: 0;
  }

  .browser:has(.is-playing) .browser-live b::after {
    animation: live-pulse 1.8s ease-out infinite;
  }

  @keyframes live-pulse {
    from { transform: scale(1); opacity: 1; }
    to { transform: scale(3.3); opacity: 0; }
  }

  .browser-view {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .browser-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(242, 239, 232, 0.08);
    z-index: 2;
  }

  .browser-progress i {
    display: block;
    height: 100%;
    background: var(--acid);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 420px) {
    .browser-live {
      display: none;
    }
  }

  .browser-view :global(.browser-poster),
  .browser-film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .browser-film {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .browser-film:global(.is-playing) {
    opacity: 1;
  }

  @media (max-width: 560px) {
    .browser-url {
      padding-inline: 0.7rem;
    }
  }
</style>
