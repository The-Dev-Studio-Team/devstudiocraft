---
import { getImage } from 'astro:assets';
import { industryCounts, trades } from '../../data/work.js';
import { media } from '../../data/media.js';

const reelPoster = await getImage({ src: media('films/reel.jpg'), format: 'webp', width: 1280, quality: 70 });

// the rolling word: every trade we build for, in its own site's accent
const roll = [
  ['barbers', 'hair'],
  ['nail studios', 'nails'],
  ['detailers', 'detailing'],
  ['gyms', 'gym'],
  ['physios', 'physio'],
  ['spas', 'massage'],
  ['dentists', 'dental'],
  ['caterers', 'events'],
  ['restaurants', 'restaurant'],
  ['cafés', 'cafe'],
].map(([word, key]) => ({ word, accent: trades.find((t) => t.industry === key)?.accent ?? '#c9f24b' }));

---

<section class="wh" aria-labelledby="work-title" data-work-hero data-intro>
  <h1 class="sr-only" id="work-title">Work by DevStudioCraft</h1>

  <div class="container wh-top">
    <p class="eyebrow" data-reveal>Selected work — 2024–{new Date().getFullYear()}</p>
    <p class="wh-count" data-reveal>Every site <span class="wh-count-n">live</span></p>
  </div>

  <!-- the reel plays inside the letters: white-on-black type multiplies onto the film, the page tone screens on top -->
  <div class="wh-word" aria-hidden="true" data-wh-word>
    <video class="wh-reel" muted loop playsinline preload="none" poster={reelPoster.src} data-wh-reel>
      <source src="/media/work/reel.webm" type="video/webm" />
      <source src="/media/work/reel.mp4" type="video/mp4" />
    </video>
    <div class="wh-knock"><span class="wh-letters" data-intro-title><span class="hl">W</span><span class="hl">O</span><span class="hl">R</span><span class="hl">K</span></span></div>
    <div class="wh-tint"></div>
  </div>

  <div class="container wh-foot">
    <p class="wh-lede" data-reveal>
      Flagship websites for
      <span class="wh-roll" aria-hidden="true" data-roll>
        {roll.map((r, i) => <span class="wh-roll-word" style={`--c:${r.accent}`} data-roll-word={i}>{r.word}</span>)}
      </span>
      <span class="sr-only">barbers, nail studios, detailers, gyms, physios, spas, dentists, caterers, restaurants and cafés</span>
      <br />designed, filmed and coded by one team.
    </p>

    <p class="wh-side" data-reveal>
      Every project below is a real, working site. Open any of them, click around, try the booking. Then pick
      your industry and see what we would build for you.
    </p>
  </div>

  <nav class="container wh-jump" aria-label="Jump to an industry" data-reveal>
    <span class="wh-jump-label">Find yours</span>
    <ul>
      {
        industryCounts.map((i) => (
          <li>
            <a href={`?industry=${i.key}#index`} data-filter-link={i.key}>
              {i.short}
              <sup>{i.count}</sup>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .wh {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1rem, 2vh, 1.6rem);
    padding-top: clamp(6rem, 12vh, 8rem);
    padding-bottom: clamp(1.4rem, 3vh, 2.4rem);
    overflow: clip;
  }

  .wh-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .wh-count {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .wh-count-n {
    color: var(--acid);
    font-variant-numeric: tabular-nums;
  }

  /* ---- the word ---- */
  .wh-word {
    position: relative;
    isolation: isolate;
    margin-inline: auto;
    width: min(100% - 2 * var(--gutter), 90rem);
    overflow: clip;
  }

  .wh-reel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .wh-knock {
    position: relative;
    z-index: 1;
    background: #000;
    color: #fff;
    mix-blend-mode: multiply;
    font-family: var(--font-display);
    font-weight: 700;
    /* four letters fill the column: ~3.06em of Clash Display 700 caps */
    font-size: min(29.6vw, 28.6rem, 58svh);
    line-height: 0.74;
    letter-spacing: -0.035em;
    text-align: center;
    padding-block: 0.04em 0.02em;
  }

  .wh-letters {
    display: inline-flex;
    overflow: clip;
    padding-block: 0.02em;
  }

  .wh-letters .hl {
    display: inline-block;
  }

  .wh-tint {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bg);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* ---- foot ---- */
  .wh-foot {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
  }

  .wh-lede {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 0.9rem + 1.5vw, 2.3rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    max-width: 40rem;
  }

  .wh-roll {
    position: relative;
    display: inline-grid;
    vertical-align: bottom;
    height: 1.12em;
    overflow: clip;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 1.12em;
    line-height: 1;
  }

  .wh-roll-word {
    grid-area: 1 / 1;
    color: var(--c);
    white-space: nowrap;
    translate: 0 110%;
  }

  .wh-roll-word:first-child {
    translate: 0 0;
  }

  .wh-side {
    max-width: 30rem;
    justify-self: end;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* ---- jump chips ---- */
  .wh-jump {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .wh-jump-label {
    flex: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .wh-jump ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .wh-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-dim);
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .wh-jump sup {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--acid);
    font-variant-numeric: tabular-nums;
  }

  .wh-jump a:hover {
    color: var(--acid-ink);
    background: var(--acid);
    border-color: var(--acid);
  }

  .wh-jump a:hover sup {
    color: var(--acid-ink);
  }

  .wh-jump a:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .wh-foot {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }

  @media (max-width: 760px) {
    .wh {
      min-height: auto;
      padding-top: 6.5rem;
    }

    /* four letters at ~3.1em must fit inside the gutters */
    .wh-knock {
      font-size: calc((100vw - 2 * var(--gutter)) / 3.2);
    }

    .wh-side {
      justify-self: start;
    }

    .wh-jump {
      flex-direction: column;
      align-items: flex-start;
    }

    /* one swipeable row instead of four wrapped lines */
    .wh-jump ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      width: calc(100% + var(--gutter));
      padding-right: var(--gutter);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }

    .wh-jump li {
      flex: none;
    }
  }
</style>
