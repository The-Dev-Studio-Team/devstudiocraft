---
import { getImage } from 'astro:assets';
import { media } from '../data/media.js';
import { reelCuts } from '../data/work.js';

const reelPoster = await getImage({ src: media('films/reel.jpg'), format: 'webp', width: 1280, quality: 72 });
const first = reelCuts[0];
---

<!--
  The screen rises: the studio reel plays in a browser that starts tipped back at the foot of the hero and,
  as you scroll, comes up flat and fills the view while the headline lifts away (main.js: initHeroScreen).
-->
<section class="hero" id="top" aria-labelledby="hero-heading" data-hero data-intro>
  <div class="hero-sticky">
    <div class="container hero-copy" data-hero-copy>
      <p class="eyebrow hero-eyebrow" data-reveal>Web studio in Bremen · working worldwide</p>

      <h1 class="h-display hero-title split-mask" id="hero-heading" data-hero-title>
        <span class="line-wrap"><span class="hl outline-text">We build</span></span>
        <span class="line-wrap"><span class="hl">websites that</span></span>
        <span class="line-wrap"><span class="hl">bring <em class="serif-i text-acid">customers.</em></span></span>
      </h1>

      <div class="hero-side">
        <p class="hero-sub" data-reveal>
          Websites, online shops, apps and brands for businesses that want more bookings, orders and calls.
          One team designs, films and builds it, and you own all of it.
        </p>
        <div class="hero-ctas" data-reveal>
          <a href="#contact" class="btn btn-acid" data-magnetic>
            <span class="btn-fill"></span>
            <span>Start your project</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6"></path>
            </svg>
          </a>
          <a href="/work/" class="btn btn-ghost" data-magnetic>
            <span class="btn-fill"></span>
            <span>See the work</span>
          </a>
        </div>
        <ul class="hero-stats" data-reveal>
        <li><strong>48h</strong><span>to your first design</span></li>
        <li><strong>95+</strong><span>Google speed score we build to</span></li>
        <li><strong>0</strong><span>templates: every site is made for you</span></li>
        <li><strong>1</strong><span>team, first call to launch</span></li>
      </ul>
      </div>


    </div>

    <div class="hero-stage" style={`--glow: ${first.accent}`} data-hero-stage>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-screen" data-hero-screen>
        <div class="hero-bar">
          <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
          <span class="hero-url" aria-hidden="true" data-reel-host>{new URL(first.url).host}</span>
          <a href="/work/" class="hero-all">All the work →</a>
        </div>
        <div class="hero-view">
          <video class="hero-reel" muted loop playsinline preload="none" poster={reelPoster.src} aria-hidden="true" data-hero-video>
            <source src="/media/work/reel-sm.webm" type="video/webm" media="(max-width: 760px)" />
            <source src="/media/work/reel-sm.mp4" type="video/mp4" media="(max-width: 760px)" />
            <source src="/media/work/reel.webm" type="video/webm" />
            <source src="/media/work/reel.mp4" type="video/mp4" />
          </video>

          <p class="hero-now" style={`--accent: ${first.accent}`} data-reel-now>
            <span class="hero-now-k">Now showing</span>
            <a href={first.url} target="_blank" rel="noopener" class="hero-now-link" data-reel-link>
              <b data-reel-name>{first.name}</b>
              <span data-reel-meta>{first.trade} · {first.place}</span>
              <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.6"></path>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-reel-cuts set:html={JSON.stringify(reelCuts)} />
</section>

<style>
  .hero {
    position: relative;
    height: 215vh;
  }

  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: clip;
    perspective: 1800px;
  }

  /* ---- copy ---- */
  .hero-copy {
    --hp: 0;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
    column-gap: 3rem;
    padding-top: clamp(6.5rem, 14vh, 9rem);
    opacity: calc(1 - var(--hp) * 1.4);
    translate: 0 calc(var(--hp) * -14vh);
  }

  .hero-eyebrow {
    grid-column: 1 / -1;
    margin-bottom: 1.4rem;
  }

  .hero-title {
    grid-column: 1;
    font-size: clamp(2.6rem, 0.6rem + 6.4vw, 7.4rem);
  }

  .line-wrap {
    display: block;
    overflow: clip;
    padding-block: 0.04em;
  }

  .hl {
    display: inline-block;
  }

  .hero-side {
    grid-column: 2;
    align-self: end;
    display: grid;
    gap: 1.5rem;
    padding-bottom: 0.6rem;
  }

  .hero-sub {
    color: var(--ink-dim);
    max-width: 30rem;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .hero-stats li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .hero-stats strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--acid);
  }

  .hero-stats span {
    font-size: 0.82rem;
    color: var(--ink-mute);
  }

  /* ---- the screen ---- */
  .hero-stage {
    /* --sp: 1 tipped back at the foot of the hero, 0 flat and filling the view (scrubbed by main.js) */
    --sp: 1;
    --glow: #c9f24b;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-top: 4.2rem;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  /* the playing site's colour, pooled behind the screen */
  .hero-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64vw;
    height: 46vh;
    border-radius: 50%;
    background: var(--glow);
    opacity: calc(0.16 + var(--sp) * 0.1);
    filter: blur(110px);
    translate: -50% calc(-50% + var(--sp) * 48vh);
    transition: background-color 0.8s ease;
    pointer-events: none;
    /* its own layer: the scrubbed translate never re-blurs it */
    will-change: transform, opacity;
  }

  .hero-screen {
    position: relative;
    width: min(94vw, calc((100vh - 7.5rem) * 1.6 + 2.2rem));
    border-radius: 1rem;
    overflow: clip;
    border: 1px solid rgba(242, 239, 232, 0.16);
    background: #0f0f13;
    box-shadow:
      0 60px 120px -40px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(0, 0, 0, 0.5);
    pointer-events: auto;
    transform-origin: 50% 0%;
    /* --rise: 1 -> 0 as the intro brings it up from below */
    transform: translateY(calc(var(--sp) * 62vh + var(--rise, 0) * 30vh)) rotateX(calc(var(--sp) * 34deg))
      scale(calc(1 - var(--sp) * 0.3));
    opacity: calc(1 - var(--rise, 0));
    will-change: transform;
  }

  .hero-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: #17171d;
    border-bottom: 1px solid var(--line);
  }

  .hero-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(242, 239, 232, 0.16);
  }

  .hero-url {
    margin-inline: auto;
    padding: 0.2rem 1.4rem;
    border-radius: 100px;
    background: rgba(242, 239, 232, 0.06);
    font-size: 0.74rem;
    color: var(--ink-dim);
    min-width: 14rem;
    text-align: center;
  }

  .hero-all {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--acid);
    white-space: nowrap;
  }

  .hero-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-all:focus-visible,
  .hero-now-link:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .hero-view {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #0b0b0e;
  }

  .hero-reel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .hero-now {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .hero-now-k {
    padding: 0.3rem 0.6rem;
    border-radius: 100px;
    background: rgb(11 11 14 / 0.78);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .hero-now-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 1rem 0.65rem 0.9rem;
    border-radius: 100px;
    background: rgb(11 11 14 / 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(242 239 232 / 0.12);
    font-size: 0.84rem;
    color: var(--ink-dim);
    transition: border-color 0.4s ease;
  }

  .hero-now-link::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
    transition: background-color 0.4s ease;
  }

  .hero-now-link b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    text-transform: uppercase;
  }

  .hero-now-link:hover {
    border-color: var(--accent);
  }

  /* ---- smaller screens: no scroll stage, the screen sits flat under the copy ---- */
  @media (max-width: 1023px), (max-height: 640px) {
    .hero {
      height: auto;
    }

    .hero-sticky {
      position: relative;
      height: auto;
      overflow: visible;
      perspective: none;
      padding-bottom: 2.5rem;
    }

    .hero-copy {
      grid-template-columns: 1fr;
      row-gap: 1.6rem;
      opacity: 1;
      translate: none;
    }

    .hero-side {
      grid-column: 1;
    }

    .hero-stage {
      position: relative;
      inset: auto;
      padding: 2.4rem var(--gutter) 0;
    }

    .hero-screen {
      width: 100%;
      transform: none;
      will-change: auto;
    }

    .hero-glow {
      display: none;
    }
  }

  /* reduced motion and no JS: the screen sits flat under the copy, no scroll stage */
  :global(html.reduced-motion) .hero,
  :global(html.no-js) .hero {
    height: auto;
  }

  :global(html.reduced-motion) .hero-sticky,
  :global(html.no-js) .hero-sticky {
    position: relative;
    height: auto;
    overflow: visible;
    perspective: none;
    padding-bottom: 2.5rem;
  }

  :global(html.reduced-motion) .hero-copy,
  :global(html.no-js) .hero-copy {
    opacity: 1;
    translate: none;
  }

  :global(html.reduced-motion) .hero-stage,
  :global(html.no-js) .hero-stage {
    position: relative;
    inset: auto;
    padding: 2.4rem var(--gutter) 0;
  }

  :global(html.reduced-motion) .hero-glow,
  :global(html.no-js) .hero-glow {
    display: none;
  }

  :global(html.reduced-motion) .hero-screen,
  :global(html.no-js) .hero-screen {
    width: min(100%, 72rem);
    transform: none;
    opacity: 1;
    will-change: auto;
  }

  @media (max-width: 560px) {
    .hero-copy {
      padding-top: 6.2rem;
    }

    .hero-title {
      font-size: clamp(2.3rem, 11.6vw, 3.4rem);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 1rem;
    }

    .hero-stats li {
      display: grid;
      gap: 0.1rem;
    }

    .hero-url {
      min-width: 0;
      padding-inline: 0.8rem;
      font-size: 0.66rem;
    }

    .hero-all {
      display: none;
    }

    .hero-view {
      aspect-ratio: 4 / 3;
    }

    .hero-now {
      left: 0.6rem;
      bottom: 0.6rem;
    }

    .hero-now-k {
      display: none;
    }

    .hero-now-link {
      gap: 0.5rem;
      padding: 0.5rem 0.8rem;
      font-size: 0.72rem;
    }

    .hero-now-link b {
      font-size: 0.84rem;
    }

    .hero-now-link span {
      display: none;
    }
  }
</style>
