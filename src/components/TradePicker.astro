---
import { Image } from 'astro:assets';
import { allWork, industryCounts } from '../data/work.js';
import { media } from '../data/media.js';

// one row per trade we sell to; each opens /work filtered to that industry
const rows = industryCounts
  .filter((i) => i.trade)
  .map((i, n) => {
    const sites = allWork.filter((w) => w.industry === i.key);
    const lead = sites[0];
    return {
      ...i,
      n: String(n + 1).padStart(2, '0'),
      names: sites.length > 3 ? `${sites.slice(0, 3).map((s) => s.name).join(', ')} +${sites.length - 3}` : sites.map((s) => s.name).join(', '),
      accent: lead.accent,
      film: lead.film,
      poster: media(lead.poster),
    };
  });
---

<section class="section tp" id="trades" aria-labelledby="tp-heading">
  <div class="container">
    <div class="tp-head">
      <p class="eyebrow" data-reveal>Built for your trade</p>
      <h2 class="h-display h2" id="tp-heading" data-split-lines>
        A site like yours. <em class="serif-i text-acid">Already live.</em>
      </h2>
      <p class="tp-intro" data-reveal>
        Pick your business. We have built a flagship for it: open it, click around, book the chair. Then picture
        your name on the door.
      </p>
    </div>

    <ol class="tp-list" data-tp-list>
      {
        rows.map((r, i) => (
          <li class="tp-row" style={`--accent: ${r.accent}`} data-tp-row={i} data-film={r.film}>
            <a href={`/work/?industry=${r.key}#index`} class="tp-link">
              <span class="tp-n" aria-hidden="true">{r.n}</span>
              <span class="tp-label">{r.label}</span>
              <span class="tp-sites">{r.names}</span>
              <span class="tp-count">
                {String(r.count).padStart(2, '0')} {r.count === 1 ? 'site' : 'sites'}
              </span>
              <span class="tp-thumb" aria-hidden="true">
                <Image src={r.poster} alt="" width={240} densities={[1, 2]} quality={70} loading="lazy" />
              </span>
              <svg class="tp-arrow" width="22" height="22" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </a>
          </li>
        ))
      }
      <li class="tp-row tp-row-else" style="--accent: #c9f24b">
        <a href="#contact" class="tp-link">
          <span class="tp-n" aria-hidden="true">+</span>
          <span class="tp-label">Something else?</span>
          <span class="tp-sites">Florist, tattoo studio, vet, yoga, hotel: tell us yours and we build the first one.</span>
          <span class="tp-count">Your trade next</span>
          <svg class="tp-arrow" width="22" height="22" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 13 13 1M13 1H3M13 1v10" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </li>
    </ol>
  </div>

  <!-- floating preview: the trade's film, following the pointer (desktop) -->
  <div class="tp-preview" aria-hidden="true" data-tp-preview>
    <div class="tp-preview-bar"><i></i><i></i><i></i></div>
    <div class="tp-preview-view">
      {rows.map((r) => <Image class="tp-preview-img" src={r.poster} alt="" width={460} densities={[1, 2]} quality={72} loading="lazy" data-tp-img />)}
      <video muted loop playsinline preload="none" data-tp-video></video>
    </div>
  </div>
</section>

<style>
  .tp-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.6rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .tp-head .eyebrow {
    grid-column: 1 / -1;
  }

  .tp-intro {
    color: var(--ink-dim);
    font-size: var(--text-lg);
    max-width: 30rem;
    text-wrap: pretty;
  }

  .tp-list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .tp-row {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .tp-link {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1.25fr) minmax(0, 1fr) 7rem 2rem;
    align-items: center;
    gap: 1.4rem;
    padding: clamp(1rem, 1.6vw, 1.5rem) 1rem;
    isolation: isolate;
    transition: color 0.45s var(--ease-expo);
  }

  /* the trade's own colour wipes in from the left */
  .tp-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-expo);
  }

  .tp-n {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
    transition: color 0.45s ease;
  }

  .tp-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 0.9rem + 2.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    transition: translate 0.6s var(--ease-expo);
  }

  .tp-sites {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    line-height: 1.25;
    color: var(--ink-dim);
    transition: color 0.45s ease;
  }

  .tp-count {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    text-align: right;
    transition: color 0.45s ease;
  }

  .tp-thumb {
    display: none;
  }

  .tp-arrow {
    justify-self: end;
    transition:
      rotate 0.5s var(--ease-expo),
      translate 0.5s var(--ease-expo);
  }

  @media (hover: hover) {
    .tp-link:hover,
    .tp-link:focus-visible {
      color: #0b0b0e;
    }

    .tp-link:hover::before,
    .tp-link:focus-visible::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    .tp-link:hover .tp-n,
    .tp-link:hover .tp-sites,
    .tp-link:hover .tp-count,
    .tp-link:focus-visible .tp-n,
    .tp-link:focus-visible .tp-sites,
    .tp-link:focus-visible .tp-count {
      color: rgb(11 11 14 / 0.78);
    }

    .tp-link:hover .tp-label {
      translate: 0.8rem 0;
    }

    .tp-link:hover .tp-arrow {
      rotate: 45deg;
    }
  }

  .tp-link:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: -2px;
  }

  .tp-row-else .tp-label {
    color: var(--acid);
    transition: color 0.45s ease;
  }

  .tp-row-else .tp-link:hover .tp-label,
  .tp-row-else .tp-link:focus-visible .tp-label {
    color: #0b0b0e;
  }

  /* ---- floating preview ---- */
  .tp-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: clamp(260px, 26vw, 400px);
    border-radius: 0.8rem;
    overflow: clip;
    border: 1px solid rgb(242 239 232 / 0.16);
    background: #0f0f13;
    pointer-events: none;
    opacity: 0;
    translate: 1.6rem -50%;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
  }

  .tp-preview-bar {
    display: flex;
    gap: 0.3rem;
    padding: 0.45rem 0.6rem;
    background: #17171d;
  }

  .tp-preview-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(242 239 232 / 0.18);
  }

  .tp-preview-view {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .tp-preview :global(.tp-preview-img),
  .tp-preview video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tp-preview :global(.tp-preview-img.is-active),
  .tp-preview video:global(.is-playing) {
    opacity: 1;
  }

  @media (hover: none), (max-width: 900px) {
    .tp-preview {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .tp-head {
      grid-template-columns: 1fr;
    }

    .tp-link {
      grid-template-columns: 2.2rem minmax(0, 1fr) 1.4rem;
      gap: 0.3rem 0.9rem;
    }

    .tp-label {
      grid-column: 2;
    }

    .tp-sites {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.98rem;
    }

    .tp-count {
      grid-column: 2;
      grid-row: 3;
      text-align: left;
      margin-top: 0.2rem;
    }

    .tp-arrow {
      grid-column: 3;
      grid-row: 1 / span 3;
    }

    .tp-n {
      grid-row: 1 / span 3;
      align-self: start;
      padding-top: 0.5rem;
    }
  }

  @media (max-width: 1023px) and (min-width: 380px) {
    /* phones get a thumbnail of the site instead of the hover film */
    .tp-link {
      grid-template-columns: 2rem minmax(0, 1fr) 5.6rem;
    }

    .tp-thumb {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 3;
      aspect-ratio: 4 / 5;
      border-radius: 0.5rem;
      overflow: clip;
      border: 1px solid var(--line);
    }

    .tp-thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
    }

    .tp-row:not(.tp-row-else) .tp-arrow {
      display: none;
    }
  }
</style>
