---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';

interface Props {
  title?: string;
  description?: string;
  // false skips the motion layer (legal pages have no animated sections)
  interactive?: boolean;
  // false skips the once-per-session intro
  intro?: boolean;
}

const HOME_DESCRIPTION =
  'DevStudioCraft is a web studio in Bremen, Germany. We build websites, online shops, apps and brands that bring businesses more customers.';

const {
  interactive = true,
  intro = true,
  title = 'DevStudioCraft — Websites, E-Commerce & Apps Built to Sell',
  description = HOME_DESCRIPTION,
} = Astro.props;

const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og.jpg', Astro.site).toString() : '/og.jpg';

// One entity graph on every page: the studio and the site it publishes.
// Facts only from the site itself (footer, Impressum, Services); no sameAs until real profiles exist.
const SITE = 'https://www.devstudiocraft.com/';
const ORG_ID = `${SITE}#organization`;
const SERVICES = [
  'Brand Identity',
  'Web Design & Development',
  'E-Commerce',
  'Landing Pages',
  'Mobile Apps',
  'Motion & Content',
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': ORG_ID,
      name: 'DevStudioCraft',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}favicon.svg` },
      image: `${SITE}og.jpg`,
      description: HOME_DESCRIPTION,
      email: 'contact@devstudiocraft.com',
      telephone: '+49 1522 2002210',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Bürgermeister-Smidt-Straße 116',
        postalCode: '28195',
        addressLocality: 'Bremen',
        addressCountry: 'DE',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: 'contact@devstudiocraft.com',
        telephone: '+49 1522 2002210',
        url: `${SITE}call/`,
      },
      parentOrganization: {
        '@type': 'Organization',
        name: 'M2A Facility Management GmbH',
        url: 'https://m2a-fm.de/',
      },
      areaServed: 'Worldwide',
      knowsAbout: SERVICES,
      makesOffer: SERVICES.map((name) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}#website`,
      name: 'DevStudioCraft',
      url: SITE,
      inLanguage: 'en',
      publisher: { '@id': ORG_ID },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function (root) {
        root.classList.remove('no-js');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still) root.classList.add('reduced-motion');
        // the intro plays on the first page of a session only: work -> home never replays it
        try {
          if (!still && !sessionStorage.getItem('dsc-intro') && !new URLSearchParams(location.search).has('nointro')) {
            root.classList.add('pl-play');
          }
          sessionStorage.setItem('dsc-intro', '1');
        } catch (e) {}
      })(document.documentElement);
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <slot name="head" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    {intro && <Preloader />}
    <slot />
    {
      interactive && (
        <script>
          import '../scripts/main.js';
        </script>
      )
    }
  </body>
</html>
