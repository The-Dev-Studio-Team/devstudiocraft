---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';

interface Props {
  title?: string;
  description?: string;
  // false skips the motion layer (legal pages have no animated sections)
  interactive?: boolean;
  // false skips the once-per-session intro
  intro?: boolean;
}

const {
  interactive = true,
  intro = true,
  title = 'DevStudioCraft — Websites, E-Commerce & Apps Built to Sell',
  description =
    'Websites, online shops, apps and brands for businesses that want more customers. 28 live sites for barbers, salons, detailers, gyms, clinics, restaurants, cafés and more. Studio in Bremen.',
} = Astro.props;

const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og.jpg', Astro.site).toString() : '/og.jpg';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function (root) {
        root.classList.remove('no-js');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still) root.classList.add('reduced-motion');
        // the intro plays on the first page of a session only: work -> home never replays it
        try {
          if (!still && !sessionStorage.getItem('dsc-intro') && !new URLSearchParams(location.search).has('nointro')) {
            root.classList.add('pl-play');
          }
          sessionStorage.setItem('dsc-intro', '1');
        } catch (e) {}
      })(document.documentElement);
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'DevStudioCraft',
        url: 'https://www.devstudiocraft.com',
        email: 'contact@devstudiocraft.com',
        telephone: '+49 1522 2002210',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Bürgermeister-Smidt-Straße 116',
          postalCode: '28195',
          addressLocality: 'Bremen',
          addressCountry: 'DE',
        },
        parentOrganization: {
          '@type': 'Organization',
          name: 'M2A Facility Management GmbH',
          url: 'https://m2a-fm.de/',
        },
        description,
        areaServed: 'Worldwide',
        makesOffer: [
          { '@type': 'Offer', name: 'Brand Identity Design' },
          { '@type': 'Offer', name: 'Web Design & Development' },
          { '@type': 'Offer', name: 'E-Commerce Development' },
          { '@type': 'Offer', name: 'Landing Page Development' },
          { '@type': 'Offer', name: 'Mobile App Development' },
        ],
      })}
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    {intro && <Preloader />}
    <slot />
    {
      interactive && (
        <script>
          import '../scripts/main.js';
        </script>
      )
    }
  </body>
</html>
