---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// cal.com event shown inline; the same link opens in a new tab if the embed cannot load
const CAL_LINK = 'devstudiocraft/intro-call';
---

<Base
  interactive={false}
  intro={false}
  title="Book an intro call — DevStudioCraft"
  description="Book a 20-minute intro call with DevStudioCraft about your website, shop, app or brand. Get a written plan and fixed price within one working day."
>
  <Fragment slot="head">
    <!-- open the connection to cal.com while the page parses, so the calendar shows sooner -->
    <link rel="preconnect" href="https://app.cal.com" />
    <link rel="preload" href="https://app.cal.com/embed/embed.js" as="script" />
  </Fragment>

  <Nav page="call" />

  <main class="call">
    <div class="container">
      <div class="call-head">
        <div>
          <p class="eyebrow">Intro call</p>
          <h1 class="h-display call-title">
            Book an intro <em class="serif-i text-acid">call.</em>
          </h1>
        </div>
        <div class="call-intro">
          <p class="call-sub">
            Twenty minutes on your project: what you need, your timeline and your budget. After the call you get a
            written plan and a fixed price within one working day.
          </p>
          <p class="call-alt">
            Rather write? <a href="mailto:contact@devstudiocraft.com">contact@devstudiocraft.com</a>
          </p>
        </div>
      </div>

      <section class="call-cal" aria-label="Choose a time">
        <div id="cal-inline" class="call-cal-frame" data-cal-link={CAL_LINK}>
          <p class="call-loading" aria-live="polite">Loading available times…</p>
        </div>
        <p class="call-fallback">
          Calendar not loading? <a href={`https://cal.com/${CAL_LINK}`} target="_blank" rel="noopener">Open it in a new tab</a>
        </p>
      </section>
    </div>
  </main>

  <Footer base="/" />
</Base>

<script>
  // this page skips main.js, so the nav's scrolled state is toggled here
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // cal.com inline embed (official loader, trimmed): queues calls until embed.js arrives
  type CalFn = ((...args: unknown[]) => void) & { q?: unknown[][]; ns?: Record<string, CalFn>; loaded?: boolean };
  const w = window as unknown as { Cal?: CalFn };

  (function (C: typeof w, src: string) {
    const push = (fn: CalFn, args: unknown[]) => (fn.q = fn.q || []).push(args);
    const cal: CalFn =
      C.Cal ||
      function (...args: unknown[]) {
        if (!cal.loaded) {
          cal.ns = {};
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          document.head.appendChild(s);
          cal.loaded = true;
        }
        if (args[0] === 'init' && typeof args[1] === 'string') {
          const name = args[1];
          const api: CalFn = (...a: unknown[]) => push(api, a);
          cal.ns![name] = cal.ns![name] || api;
          push(cal.ns![name], args);
          push(cal, ['initNamespace', name]);
          return;
        }
        push(cal, args);
      };
    C.Cal = cal;
  })(w, 'https://app.cal.com/embed/embed.js');

  const el = document.getElementById('cal-inline');
  if (el && w.Cal) {
    const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const brand = token('--acid');
    w.Cal('init', 'intro', { origin: 'https://app.cal.com' });
    const ns = w.Cal.ns!.intro;
    ns('inline', {
      elementOrSelector: '#cal-inline',
      calLink: el.dataset.calLink,
      config: { layout: 'month_view', theme: 'dark' },
    });
    ns('ui', {
      theme: 'dark',
      // phones: our heading already says what the call is, so cal.com shows only month and times
      hideEventTypeDetails: !window.matchMedia('(min-width: 64rem)').matches,
      layout: 'month_view',
      cssVarsPerTheme: { dark: { 'cal-brand': brand, 'cal-bg': token('--bg-soft'), 'cal-bg-subtle': token('--bg') } },
    });
  }
</script>

<style>
  /* top padding clears the fixed site nav */
  .call {
    padding-block: clamp(7rem, 5rem + 5vw, 10rem) clamp(4rem, 3rem + 5vw, 8rem);
  }

  /* heading left, intro right; the calendar runs full width below so cal.com shows
     details, month and a scrolling times column side by side */
  .call-head {
    display: grid;
    gap: 1.6rem clamp(2.5rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 64rem) {
    .call-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .call-title {
    font-size: clamp(3rem, 1.6rem + 5.4vw, 6.6rem);
    margin-top: 1.2rem;
  }

  .call-sub {
    max-width: 30rem;
    color: var(--ink-dim);
    font-size: var(--text-lg);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .call-alt,
  .call-fallback {
    margin-top: 1.2rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }

  .call-alt a,
  .call-fallback a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.18em;
    transition: color 0.3s ease;
  }

  .call-alt a:hover,
  .call-fallback a:hover {
    color: var(--acid);
  }

  /* tablets get cal.com's one-column layout; cap it so the day cells stay compact */
  @media (max-width: 63.99rem) {
    .call-cal {
      max-width: 36rem;
    }
  }

  /* cal.com draws its own card; this only holds the space while embed.js loads */
  .call-cal-frame {
    position: relative;
    min-height: 26rem;
  }

  .call-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--bg-soft);
    color: var(--ink-mute);
    font-size: 0.92rem;
    pointer-events: none;
  }

  /* :global because cal.com adds the iframe after Astro scoped the styles */
  :global(.call-cal-frame:has(iframe) .call-loading) {
    visibility: hidden;
  }

  .call-fallback {
    text-align: right;
  }
</style>
