---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

// cal.com event shown inline; the same link opens in a new tab if the embed cannot load
const CAL_LINK = 'devstudiocraft/intro-call';

const details = [
  { term: 'Length', value: '20 minutes' },
  { term: 'Where', value: 'Video call, or phone if you prefer' },
  { term: 'When', value: 'Any day, 08:00 to 20:00 UK time' },
  { term: 'After', value: 'A written plan and a fixed price within one working day' },
];
---

<Base
  interactive={false}
  intro={false}
  title="Book an intro call — DevStudioCraft"
  description="Pick a time for a 20-minute intro call with DevStudioCraft about your website, shop, app or brand. After the call you get a written plan and a fixed price within one working day."
>
  <header class="call-nav">
    <div class="container call-nav-inner">
      <a href="/" class="call-logo" aria-label="DevStudioCraft home">
        DEVSTUDIOCRAFT<span class="text-acid">.</span>
      </a>
      <a href="/work/" class="call-back">See our work</a>
    </div>
  </header>

  <main class="call">
    <div class="container call-grid">
      <div class="call-head">
        <p class="eyebrow">Intro call</p>
        <h1 class="h-display call-title">
          Book an intro <em class="serif-i text-acid">call.</em>
        </h1>
        <p class="call-sub">
          Twenty minutes on your project: what you need, your timeline and your budget. Pick a time that suits you.
        </p>
      </div>

      <section class="call-cal" aria-label="Choose a time">
        <div id="cal-inline" class="call-cal-frame" data-cal-link={CAL_LINK}></div>
        <p class="call-fallback">
          Calendar not loading? <a href={`https://cal.com/${CAL_LINK}`} target="_blank" rel="noopener">Open it in a new tab</a>
        </p>
      </section>

      <div class="call-info">
        <dl class="call-details">
          {
            details.map((d) => (
              <div class="call-row">
                <dt>{d.term}</dt>
                <dd>{d.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="call-alt">
          Rather write? <a href="mailto:contact@devstudiocraft.com">contact@devstudiocraft.com</a>
        </p>
      </div>
    </div>
  </main>

  <Footer base="/" />
</Base>

<script>
  // cal.com inline embed (official loader, trimmed): queues calls until embed.js arrives
  type CalFn = ((...args: unknown[]) => void) & { q?: unknown[][]; ns?: Record<string, CalFn>; loaded?: boolean };
  const w = window as unknown as { Cal?: CalFn };

  (function (C: typeof w, src: string) {
    const push = (fn: CalFn, args: unknown[]) => (fn.q = fn.q || []).push(args);
    const cal: CalFn =
      C.Cal ||
      function (...args: unknown[]) {
        if (!cal.loaded) {
          cal.ns = {};
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          document.head.appendChild(s);
          cal.loaded = true;
        }
        if (args[0] === 'init' && typeof args[1] === 'string') {
          const name = args[1];
          const api: CalFn = (...a: unknown[]) => push(api, a);
          cal.ns![name] = cal.ns![name] || api;
          push(cal.ns![name], args);
          push(cal, ['initNamespace', name]);
          return;
        }
        push(cal, args);
      };
    C.Cal = cal;
  })(w, 'https://app.cal.com/embed/embed.js');

  const el = document.getElementById('cal-inline');
  if (el && w.Cal) {
    const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const brand = token('--acid');
    w.Cal('init', 'intro', { origin: 'https://app.cal.com' });
    const ns = w.Cal.ns!.intro;
    ns('inline', {
      elementOrSelector: '#cal-inline',
      calLink: el.dataset.calLink,
      config: { layout: 'month_view', theme: 'dark' },
    });
    ns('ui', {
      theme: 'dark',
      hideEventTypeDetails: true,
      layout: 'month_view',
      cssVarsPerTheme: { dark: { 'cal-brand': brand, 'cal-bg': token('--bg-soft') } },
    });
  }
</script>

<style>
  .call-nav {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .call-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .call-logo {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
  }

  .call-back {
    color: var(--ink-dim);
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .call-back:hover {
    color: var(--acid);
  }

  .call {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(4rem, 3rem + 5vw, 8rem);
  }

  /* phone: heading, calendar, details; desktop: copy left, calendar right */
  .call-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .call-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'head cal'
        'info cal';
      grid-template-rows: auto 1fr;
    }

    .call-head {
      grid-area: head;
    }

    .call-cal {
      grid-area: cal;
    }

    .call-info {
      grid-area: info;
    }
  }

  .call-title {
    font-size: clamp(3rem, 1.6rem + 5.4vw, 6.6rem);
    max-width: 9ch;
    margin-top: 1.2rem;
  }

  .call-sub {
    margin-top: 1.6rem;
    max-width: 30rem;
    color: var(--ink-dim);
    font-size: var(--text-lg);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .call-details {
    max-width: 30rem;
    border-top: 1px solid var(--line);
  }

  .call-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .call-row dt {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 0.15rem;
  }

  .call-row dd {
    color: var(--ink);
  }

  .call-alt,
  .call-fallback {
    margin-top: 1.4rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }

  .call-alt a,
  .call-fallback a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.18em;
    transition: color 0.3s ease;
  }

  .call-alt a:hover,
  .call-fallback a:hover {
    color: var(--acid);
  }

  /* placeholder height while embed.js loads; the iframe then sizes itself */
  .call-cal-frame {
    min-height: 26rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    overflow: clip;
  }

  .call-fallback {
    text-align: right;
  }
</style>
