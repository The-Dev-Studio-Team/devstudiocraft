---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WorkHero from '../components/work/WorkHero.astro';
import ChapterRail from '../components/work/ChapterRail.astro';
import Trades from '../components/work/Trades.astro';
import WorkIndex from '../components/work/WorkIndex.astro';
import CoffeeSeries from '../components/work/CoffeeSeries.astro';
import Aviation from '../components/work/Aviation.astro';
import Spaces from '../components/work/Spaces.astro';
import Identity from '../components/work/Identity.astro';
import Toolbox from '../components/work/Toolbox.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<!-- interactive={false}: this page boots its own motion layer (scripts/work.js), not main.js -->
<Base
  interactive={false}
  title="Work — DevStudioCraft"
  description="28 live sites by DevStudioCraft: flagship websites for barbers, nail studios, car detailers, gyms, physios, spas, dentists, caterers, restaurants and cafés, plus the Pilot 100 and Airyona aviation platforms, a residence tour and the identity systems behind them."
>
  <Nav page="work" />
  <ChapterRail />
  <main>
    <WorkHero />
    <Trades />
    <WorkIndex />
    <CoffeeSeries />
    <Aviation />
    <Spaces />
    <Identity />
    <Toolbox />
    <CTA />
  </main>
  <Footer base="/" />
</Base>

<script>
  import '../scripts/work.js';
</script>
