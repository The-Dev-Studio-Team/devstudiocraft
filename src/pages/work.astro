---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import Nav from '../components/Nav.astro';
import WorkHero from '../components/work/WorkHero.astro';
import ChapterRail from '../components/work/ChapterRail.astro';
import CoffeeSeries from '../components/work/CoffeeSeries.astro';
import Aviation from '../components/work/Aviation.astro';
import Spaces from '../components/work/Spaces.astro';
import Identity from '../components/work/Identity.astro';
import Toolbox from '../components/work/Toolbox.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<!-- interactive={false}: this page boots its own motion layer (scripts/work.js), not main.js -->
<Base
  interactive={false}
  title="Work — DevStudioCraft"
  description="Selected work by DevStudioCraft: twelve coffee brands, the Pilot 100 and Airyona aviation platforms, an interactive residence tour, and the identity systems behind them. Designed, engineered and shipped by one team."
>
  <Cursor />
  <Nav page="work" />
  <ChapterRail />
  <main>
    <WorkHero />
    <CoffeeSeries />
    <Aviation />
    <Spaces />
    <Identity />
    <Toolbox />
    <CTA />
  </main>
  <Footer base="/" />
</Base>

<script>
  import '../scripts/work.js';
</script>
